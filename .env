# ==========================================
# CONFIGURAÇÕES DE AMBIENTE
# ==========================================

# Ambiente de execução
NODE_ENV=development
PYTHON_ENV=development

# ==========================================
# APIS EXTERNAS - EXCHANGES
# ==========================================

# Binance API (para dados de mercado)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Coinbase API (opcional)
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET=your_coinbase_secret_here

# ==========================================
# APIS EXTERNAS - NOTÍCIAS
# ==========================================

# NewsAPI (https://newsapi.org/)
NEWS_API_KEY=your_newsapi_key_here

# GNews API (https://gnews.io/)
GNEWS_API_KEY=your_gnews_api_key_here

# ==========================================
# SEGURANÇA E AUTENTICAÇÃO
# ==========================================

# JWT Secret (gere uma chave forte)
JWT_SECRET=your_very_strong_jwt_secret_here_min_32_chars

# CORS Origins (URLs permitidas)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# ==========================================

# PostgreSQL Principal
POSTGRES_DB=aitrading_db
POSTGRES_USER=aitrading_user
POSTGRES_PASSWORD=aitrading_pass

# TimescaleDB (corrigindo nomes das variáveis)
TIMESCALE_DB=crypto_market
TIMESCALE_USER=crypto_user
TIMESCALE_PASSWORD=crypto_pass

# Grafana
GRAFANA_PASSWORD=admin123


# # MongoDB
# MONGODB_HOST=mongodb
# MONGODB_PORT=27017
# MONGODB_DATABASE=crypto_news
# MONGODB_USER=crypto_user
# MONGODB_PASSWORD=crypto_pass

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# CONFIGURAÇÕES DOS MICROSERVIÇOS
# ==========================================

# API Gateway
API_GATEWAY_PORT=8080
API_GATEWAY_HOST=0.0.0.0

# WebSocket Service
WEBSOCKET_PORT=8081
WEBSOCKET_HOST=0.0.0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8081

# ==========================================
# CONFIGURAÇÕES DE TRADING
# ==========================================

# Símbolos para monitoramento (separados por vírgula)
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,ADAUSDT,DOTUSDT,SOLUSDT

# Intervalos de coleta (1m, 5m, 15m, 1h, 4h, 1d)
MARKET_DATA_INTERVALS=1m,5m,15m,1h

# Configurações de alertas
ENABLE_NOTIFICATIONS=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ==========================================
# CONFIGURAÇÕES DE IA/ML
# ==========================================

# Modelo de sentimento
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
MODEL_CACHE_DIR=./ai-models/cache

# Configurações de análise técnica
TECHNICAL_INDICATORS=SMA,EMA,RSI,MACD,BOLLINGER_BANDS
RSI_PERIOD=14
SMA_PERIODS=20,50,200
EMA_PERIODS=12,26

# ==========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ==========================================

# Logs
LOG_LEVEL=info
LOG_FORMAT=json

# Desenvolvimento
ENABLE_DEBUG=false
ENABLE_PROFILING=false

# Hot reload (apenas desenvolvimento)
ENABLE_HOT_RELOAD=true

# APIs (valores temporários para teste)
ALPHA_VANTAGE_API_KEY=demo
POLYGON_API_KEY=demo
BRAPI_TOKEN=demo
