            const percentile5 = report.percentile_5 || 0;
            const percentile95 = report.percentile_95 || 0;
            const probProfit = report.probability_of_profit || 0;
            const sharpeRatio = report.mean_sharpe_ratio || report.mean_sharpe || 0;
            const var95Value = report.value_at_risk_95 || report.value_at_risk || 0;
            
            const meanReturnEl = document.getElementById('meanReturn');
            if (meanReturnEl) {
                meanReturnEl.textContent = `${meanReturn.toFixed(2)}%`;
                meanReturnEl.className = 'metric-value ' + (meanReturn > 0 ? 'positive' : 'negative');
            }
            
            const meanReturnCi = document.getElementById('meanReturnCi');
            if (meanReturnCi) {
                meanReturnCi.textContent = 
                    `95% CI: [${percentile5.toFixed(2)}%, ${percentile95.toFixed(2)}%]`;
            }
            
            const probProfitEl = document.getElementById('probProfit');
            if (probProfitEl) {
                probProfitEl.textContent = `${probProfit.toFixed(1)}%`;
                probProfitEl.className = 'metric-value ' + (probProfit >= 60 ? 'positive' : 'negative');
            }
            
            const sharpeEl = document.getElementById('sharpeRatio');
            if (sharpeEl) {
                sharpeEl.textContent = sharpeRatio.toFixed(2);
                sharpeEl.className = 'metric-value ' + 
                    (sharpeRatio > 1.5 ? 'positive' : sharpeRatio > 0.5 ? 'neutral' : 'negative');
            }
            
            const sharpeQuality = document.getElementById('sharpeQuality');
            if (sharpeQuality) {
                sharpeQuality.textContent = 
                    sharpeRatio > 2.0 ? 'Excelente' :
                    sharpeRatio > 1.5 ? 'Bom' :
                    sharpeRatio > 0.5 ? 'Aceitável' : 'Ruim';
            }
            
            const var95El = document.getElementById('var95');
            if (var95El) {
                var95El.textContent = `${var95Value.toFixed(2)}%`;
                var95El.className = 'metric-value ' + (var95Value > -15 ? 'positive' : 'negative');
            }
        }
        
