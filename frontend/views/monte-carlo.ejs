        function renderComparisonTable() {
            const tbody = document.getElementById('comparisonTableBody');
            tbody.innerHTML = '';
            
            if (allReports.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center">Nenhum relatório disponível</td></tr>';
                return;
            }
            
            // Validate and filter reports with required fields
            const validReports = allReports.filter(r => {
                const hasRequiredFields = r.mean_return !== undefined && 
                                         r.probability_of_profit !== undefined &&
                                         r.mean_sharpe !== undefined &&
                                         r.value_at_risk !== undefined;
                if (!hasRequiredFields) {
                    console.warn('Invalid report structure:', r);
                }
                return hasRequiredFields;
            });
            
            if (validReports.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center text-warning">Relatórios sem dados válidos. Execute uma simulação.</td></tr>';
                return;
            }
            
            // Calculate scores and sort
            const scored = validReports.map(r => ({
                ...r,
                score: (r.mean_return * 0.3) + (r.probability_of_profit * 0.3) + 
                       (r.mean_sharpe * 10 * 0.2) + (r.value_at_risk * -0.2)
            })).sort((a, b) => b.score - a.score);
            
            scored.forEach((report, index) => {
                const row = document.createElement('tr');
                
                let rankBadge = '';
                if (index === 0) rankBadge = '<span class="rank-badge rank-1">🥇 1º</span>';
                else if (index === 1) rankBadge = '<span class="rank-badge rank-2">🥈 2º</span>';
                else if (index === 2) rankBadge = '<span class="rank-badge rank-3">🥉 3º</span>';
                else rankBadge = `<span class="badge bg-secondary">${index + 1}º</span>`;
                
                // Safe value extraction with defaults
                const meanReturn = report.mean_return || 0;
                const probProfit = report.probability_of_profit || 0;
                const meanSharpe = report.mean_sharpe || 0;
                const var95 = report.value_at_risk || 0;
                const iterations = report.iterations || 0;
                const score = report.score || 0;
                
                const returnClass = meanReturn > 0 ? 'text-success fw-bold' : 'text-danger fw-bold';
                
                row.innerHTML = `
                    <td>${rankBadge}</td>
                    <td><strong>${report.strategy || 'Unknown'}</strong></td>
                    <td class="${returnClass}">${meanReturn.toFixed(2)}%</td>
                    <td>${probProfit.toFixed(1)}%</td>
                    <td>${meanSharpe.toFixed(2)}</td>
                    <td>${var95.toFixed(2)}%</td>
                    <td>--</td>
                    <td>${iterations.toLocaleString()}</td>
                    <td><span class="badge bg-primary">${score.toFixed(2)}</span></td>
                `;
                
                row.style.cursor = 'pointer';
                row.onclick = () => selectStrategy(report.strategy);
                
                tbody.appendChild(row);
            });
        }
        
        function calculateAggregatedMetrics() {
            if (allReports.length === 0) return;
            
            const avgReturn = allReports.reduce((sum, r) => sum + r.mean_return, 0) / allReports.length;
            const avgProb = allReports.reduce((sum, r) => sum + r.probability_of_profit, 0) / allReports.length;
            const avgSharpe = allReports.reduce((sum, r) => sum + r.mean_sharpe, 0) / allReports.length;
            const avgVar = allReports.reduce((sum, r) => sum + r.value_at_risk, 0) / allReports.length;
            
            document.getElementById('meanReturn').textContent = `${avgReturn.toFixed(2)}%`;
            document.getElementById('meanReturn').className = 'metric-value ' + (avgReturn > 0 ? 'positive' : 'negative');
            document.getElementById('meanReturnCi').textContent = '(média de todas)';
            
            document.getElementById('probProfit').textContent = `${avgProb.toFixed(1)}%`;
            document.getElementById('probProfit').className = 'metric-value neutral';
            
            document.getElementById('sharpeRatio').textContent = avgSharpe.toFixed(2);
            document.getElementById('sharpeRatio').className = 'metric-value neutral';
            document.getElementById('sharpeQuality').textContent = 'Média geral';
            
            document.getElementById('var95').textContent = `${avgVar.toFixed(2)}%`;
            document.getElementById('var95').className = 'metric-value neutral';
        }
        
        function refreshData() {
            location.reload();
        }
    </script>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
