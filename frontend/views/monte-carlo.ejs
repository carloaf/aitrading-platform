            const medianReturn = medianCase.total_return || 0;
            const worstReturn = worstCase.total_return || 0;
            
            const bestEl = document.getElementById('bestCase');
            const medianEl = document.getElementById('medianCase');
            const worstEl = document.getElementById('worstCase');
            
            if (bestEl) bestEl.textContent = `${bestReturn >= 0 ? '+' : ''}${bestReturn.toFixed(2)}%`;
            if (medianEl) medianEl.textContent = `${medianReturn >= 0 ? '+' : ''}${medianReturn.toFixed(2)}%`;
            if (worstEl) worstEl.textContent = `${worstReturn.toFixed(2)}%`;
        }
        
        function renderRiskMetrics(report) {
