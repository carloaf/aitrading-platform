<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - AI Trading Platform</title>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- Chart.js with Financial Plugin -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@2.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    
    <style>
        :root {
            --primary-color: #6c5ce7;
            --secondary-color: #00cec9;
            --success-color: #00c896;
            --danger-color: #ff4757;
            --warning-color: #ffa726;
            --dark-bg: #1a1a1a;
            --card-bg: #2d3748;
            --border-color: #4a5568;
        }

        body {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d3748 100%);
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .navbar {
            background: rgba(26, 26, 26, 0.95) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 15px;
            backdrop-filter: blur(10px);
        }

        .chart-container {
            background: var(--card-bg);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid var(--border-color);
        }

        .indicator-card {
            background: rgba(45, 55, 72, 0.8);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid var(--border-color);
        }

        .indicator-value {
            font-size: 1.2rem;
            font-weight: bold;
        }

        .signal-buy { color: var(--success-color); }
        .signal-sell { color: var(--danger-color); }
        .signal-neutral { color: var(--warning-color); }

        .btn-indicator {
            margin: 5px;
            border-radius: 20px;
        }

        .btn-indicator.active {
            background: var(--primary-color);
            border-color: var(--primary-color);
        }

        .nav-tabs .nav-link {
            color: #fff;
            border: none;
            background: transparent;
        }

        .nav-tabs .nav-link.active {
            background: var(--primary-color);
            color: #fff;
        }

        .chart-canvas {
            width: 100%;
            height: 400px;
        }

        .indicator-canvas {
            width: 100%;
            height: 150px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-chart-line me-2"></i>AI Trading Platform
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard">
                            <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/signals">
                            <i class="fas fa-signal me-1"></i>Sinais
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/backtesting">
                            <i class="fas fa-history me-1"></i>Backtesting
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/technical-analysis">
                            <i class="fas fa-chart-bar me-1"></i>Análise Técnica
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid mt-4">
        <div class="row">
            <!-- Main Chart Area -->
            <div class="col-lg-9">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-chart-candlestick me-2"></i>Análise Técnica Avançada
                            <span class="badge bg-success ms-2" id="currentSymbol">BTCUSDT</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Price Info -->
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <div class="d-flex align-items-center">
                                    <h4 id="currentPrice" class="mb-0 me-2">$45,234.56</h4>
                                    <span id="priceChange" class="badge bg-success">+2.34%</span>
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-light btn-sm" onclick="changeTimeframe('1m')">1m</button>
                                    <button type="button" class="btn btn-outline-light btn-sm" onclick="changeTimeframe('5m')">5m</button>
                                    <button type="button" class="btn btn-outline-light btn-sm active" onclick="changeTimeframe('1h')">1h</button>
                                    <button type="button" class="btn btn-outline-light btn-sm" onclick="changeTimeframe('4h')">4h</button>
                                    <button type="button" class="btn btn-outline-light btn-sm" onclick="changeTimeframe('1d')">1d</button>
                                </div>
                            </div>
                        </div>

                        <!-- Main Chart -->
                        <div class="chart-container">
                            <canvas id="mainChart" class="chart-canvas"></canvas>
                        </div>

                        <!-- Indicator Charts -->
                        <div id="indicatorCharts">
                            <div id="rsiContainer" style="display: none;">
                                <h6>RSI (14)</h6>
                                <canvas id="rsiChart" class="indicator-canvas"></canvas>
                            </div>
                            <div id="macdContainer" style="display: none;">
                                <h6>MACD</h6>
                                <canvas id="macdChart" class="indicator-canvas"></canvas>
                            </div>
                        </div>

                        <!-- Indicator Controls -->
                        <div class="mt-3">
                            <h6>Indicadores:</h6>
                            <button class="btn btn-outline-primary btn-indicator" onclick="toggleIndicator('rsi')">
                                <i class="fas fa-wave-square me-1"></i>RSI
                            </button>
                            <button class="btn btn-outline-primary btn-indicator" onclick="toggleIndicator('macd')">
                                <i class="fas fa-chart-line me-1"></i>MACD
                            </button>
                            <button class="btn btn-outline-primary btn-indicator" onclick="toggleIndicator('bollinger')">
                                <i class="fas fa-compress-alt me-1"></i>Bollinger Bands
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-3">
                <!-- Current Indicators -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-calculator me-2"></i>Indicadores Atuais
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="indicator-card">
                            <div class="d-flex justify-content-between">
                                <span>RSI (14)</span>
                                <span class="indicator-value signal-neutral" id="rsiValue">65.43</span>
                            </div>
                        </div>
                        <div class="indicator-card">
                            <div class="d-flex justify-content-between">
                                <span>MACD</span>
                                <span class="indicator-value signal-buy" id="macdValue">0.0234</span>
                            </div>
                        </div>
                        <div class="indicator-card">
                            <div class="d-flex justify-content-between">
                                <span>Volume</span>
                                <span class="indicator-value" id="volumeValue">1.2M</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Trading Signals -->
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-signal me-2"></i>Sinais de Trading
                        </h6>
                    </div>
                    <div class="card-body">
                        <div id="tradingSignals">
                            <div class="alert alert-success">
                                <strong>COMPRA</strong><br>
                                RSI em zona de sobrevenda
                            </div>
                            <div class="alert alert-warning">
                                <strong>NEUTRO</strong><br>
                                MACD próximo da linha zero
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        class TechnicalAnalysisChartJS {
            constructor() {
                this.charts = {};
                this.currentSymbol = 'BTCUSDT';
                this.currentTimeframe = '1h';
                this.activeIndicators = new Set();
                this.mockData = this.generateMockData();
                
                this.initializeCharts();
                this.updateIndicators();
            }

            generateMockData() {
                const data = [];
                const now = new Date();
                const basePrice = 45000;
                
                for (let i = 100; i >= 0; i--) {
                    const time = new Date(now.getTime() - i * 60 * 60 * 1000);
                    const open = basePrice + (Math.random() - 0.5) * 1000;
                    const close = open + (Math.random() - 0.5) * 500;
                    const high = Math.max(open, close) + Math.random() * 200;
                    const low = Math.min(open, close) - Math.random() * 200;
                    const volume = Math.random() * 1000000;
                    
                    data.push({ time, open, high, low, close, volume });
                }
                
                return data;
            }

            initializeCharts() {
                try {
                    // Main Price Chart
                    const ctx = document.getElementById('mainChart').getContext('2d');
                    
                    this.charts.main = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: this.mockData.map(d => d.time),
                            datasets: [{
                                label: 'Preço',
                                data: this.mockData.map(d => d.close),
                                borderColor: '#00c896',
                                backgroundColor: 'rgba(0, 200, 150, 0.1)',
                                borderWidth: 2,
                                fill: true
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    labels: { color: '#fff' }
                                }
                            },
                            scales: {
                                x: {
                                    type: 'time',
                                    time: { unit: 'hour' },
                                    ticks: { color: '#fff' },
                                    grid: { color: '#404040' }
                                },
                                y: {
                                    ticks: { color: '#fff' },
                                    grid: { color: '#404040' }
                                }
                            }
                        }
                    });

                    console.log('✅ Chart.js gráfico principal criado com sucesso!');
                    
                } catch (error) {
                    console.error('❌ Erro ao criar gráfico:', error);
                    document.getElementById('mainChart').insertAdjacentHTML('afterend', 
                        '<div class="alert alert-danger">Erro ao carregar gráfico: ' + error.message + '</div>'
                    );
                }
            }

            toggleIndicator(indicator) {
                const button = event.target.closest('button');
                
                if (this.activeIndicators.has(indicator)) {
                    this.activeIndicators.delete(indicator);
                    button.classList.remove('active');
                    document.getElementById(indicator + 'Container').style.display = 'none';
                } else {
                    this.activeIndicators.add(indicator);
                    button.classList.add('active');
                    this.createIndicatorChart(indicator);
                }
            }

            createIndicatorChart(indicator) {
                const container = document.getElementById(indicator + 'Container');
                container.style.display = 'block';
                
                if (indicator === 'rsi') {
                    this.createRSIChart();
                } else if (indicator === 'macd') {
                    this.createMACDChart();
                }
            }

            createRSIChart() {
                const ctx = document.getElementById('rsiChart').getContext('2d');
                const rsiData = this.calculateRSI(this.mockData.map(d => d.close));
                
                this.charts.rsi = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: this.mockData.slice(-rsiData.length).map(d => d.time),
                        datasets: [{
                            label: 'RSI',
                            data: rsiData,
                            borderColor: '#ffa726',
                            backgroundColor: 'rgba(255, 167, 38, 0.1)',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { labels: { color: '#fff' } }
                        },
                        scales: {
                            x: {
                                type: 'time',
                                ticks: { color: '#fff' },
                                grid: { color: '#404040' }
                            },
                            y: {
                                min: 0,
                                max: 100,
                                ticks: { color: '#fff' },
                                grid: { color: '#404040' }
                            }
                        }
                    }
                });
            }

            createMACDChart() {
                const ctx = document.getElementById('macdChart').getContext('2d');
                const macdData = this.calculateMACD(this.mockData.map(d => d.close));
                
                this.charts.macd = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: this.mockData.slice(-macdData.macd.length).map(d => d.time),
                        datasets: [{
                            label: 'MACD',
                            data: macdData.macd,
                            borderColor: '#00d4aa',
                            borderWidth: 2,
                            fill: false
                        }, {
                            label: 'Signal',
                            data: macdData.signal,
                            borderColor: '#ff4757',
                            borderWidth: 2,
                            fill: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { labels: { color: '#fff' } }
                        },
                        scales: {
                            x: {
                                type: 'time',
                                ticks: { color: '#fff' },
                                grid: { color: '#404040' }
                            },
                            y: {
                                ticks: { color: '#fff' },
                                grid: { color: '#404040' }
                            }
                        }
                    }
                });
            }

            calculateRSI(prices, period = 14) {
                const rsi = [];
                const gains = [];
                const losses = [];
                
                for (let i = 1; i < prices.length; i++) {
                    const change = prices[i] - prices[i-1];
                    gains.push(change > 0 ? change : 0);
                    losses.push(change < 0 ? Math.abs(change) : 0);
                }
                
                for (let i = period - 1; i < gains.length; i++) {
                    const avgGain = gains.slice(i - period + 1, i + 1).reduce((a, b) => a + b) / period;
                    const avgLoss = losses.slice(i - period + 1, i + 1).reduce((a, b) => a + b) / period;
                    const rs = avgGain / avgLoss;
                    rsi.push(100 - (100 / (1 + rs)));
                }
                
                return rsi;
            }

            calculateMACD(prices) {
                const ema12 = this.calculateEMA(prices, 12);
                const ema26 = this.calculateEMA(prices, 26);
                const macd = [];
                
                for (let i = 0; i < Math.min(ema12.length, ema26.length); i++) {
                    macd.push(ema12[i] - ema26[i]);
                }
                
                const signal = this.calculateEMA(macd, 9);
                
                return { macd: macd.slice(-signal.length), signal };
            }

            calculateEMA(prices, period) {
                const ema = [];
                const multiplier = 2 / (period + 1);
                ema[0] = prices[0];
                
                for (let i = 1; i < prices.length; i++) {
                    ema[i] = (prices[i] * multiplier) + (ema[i-1] * (1 - multiplier));
                }
                
                return ema;
            }

            updateIndicators() {
                // Update current values
                const lastPrice = this.mockData[this.mockData.length - 1].close;
                const rsiData = this.calculateRSI(this.mockData.map(d => d.close));
                const macdData = this.calculateMACD(this.mockData.map(d => d.close));
                
                document.getElementById('currentPrice').textContent = '$' + lastPrice.toFixed(2);
                document.getElementById('rsiValue').textContent = rsiData[rsiData.length - 1]?.toFixed(2) || '--';
                document.getElementById('macdValue').textContent = macdData.macd[macdData.macd.length - 1]?.toFixed(4) || '--';
            }
        }

        // Global functions
        function changeTimeframe(timeframe) {
            // Remove active class from all buttons
            document.querySelectorAll('.btn-group .btn').forEach(btn => btn.classList.remove('active'));
            // Add active class to clicked button
            event.target.classList.add('active');
            
            console.log('Timeframe changed to:', timeframe);
        }

        function toggleIndicator(indicator) {
            if (window.technicalAnalysis) {
                window.technicalAnalysis.toggleIndicator(indicator);
            }
        }

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', () => {
            window.technicalAnalysis = new TechnicalAnalysisChartJS();
        });
    </script>
</body>
</html>
