<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Trading Platform - Análise Técnica</title>
    
    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📊</text></svg>">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <!-- TradingView Lightweight Charts - Using v3.3.0 (known working version) -->
    <script src="https://unpkg.com/lightweight-charts@3.3.0/dist/lightweight-charts.standalone.production.js"></script>
    
    <!-- Custom Styles -->
    <style>
        :root {
            --primary-color: #1a1a1a;
            --secondary-color: #2d2d2d;
            --accent-color: #00d4aa;
            --text-color: #ffffff;
            --text-secondary: #b0b0b0;
            --success-color: #00c896;
            --danger-color: #ff4757;
            --warning-color: #ffa726;
            --info-color: #3742fa;
        }

        body {
            background-color: var(--primary-color);
            color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            padding: 0;
        }

        .navbar {
            background-color: var(--secondary-color);
            border-bottom: 1px solid #404040;
            padding: 0.5rem 1rem;
        }

        .navbar-brand {
            color: var(--accent-color) !important;
            font-weight: bold;
            font-size: 1.4rem;
        }

        .nav-link {
            color: var(--text-secondary) !important;
            transition: color 0.3s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--accent-color) !important;
        }

        .container-fluid {
            padding: 1rem;
        }

        .card {
            background-color: var(--secondary-color);
            border: 1px solid #404040;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .card-header {
            background-color: var(--secondary-color);
            border-bottom: 1px solid #404040;
            color: var(--text-color);
            font-weight: 600;
        }

        .card-body {
            background-color: var(--secondary-color);
            color: var(--text-color);
        }

        .chart-container {
            background-color: var(--secondary-color);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
            border: 1px solid #404040;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #404040;
        }

        .chart-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--text-color);
        }

        .chart-canvas {
            height: 500px;
            width: 100%;
        }

        .indicator-canvas {
            height: 150px;
            width: 100%;
            margin-top: 0.5rem;
        }

        .form-control, .form-select {
            background-color: var(--primary-color);
            border: 1px solid #404040;
            color: var(--text-color);
        }

        .form-control:focus, .form-select:focus {
            background-color: var(--primary-color);
            border-color: var(--accent-color);
            box-shadow: 0 0 0 0.2rem rgba(0, 212, 170, 0.25);
            color: var(--text-color);
        }

        .btn-primary {
            background-color: var(--accent-color);
            border-color: var(--accent-color);
            color: #000;
            font-weight: 600;
        }

        .btn-primary:hover {
            background-color: #00b894;
            border-color: #00b894;
        }

        .btn-outline-light {
            color: var(--text-color);
            border-color: #404040;
        }

        .btn-outline-light:hover {
            background-color: var(--accent-color);
            border-color: var(--accent-color);
            color: #000;
        }

        .btn-outline-light.active {
            background-color: var(--accent-color);
            border-color: var(--accent-color);
            color: #000;
        }

        .indicator-panel {
            max-height: 400px;
            overflow-y: auto;
        }

        .indicator-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem;
            margin-bottom: 0.5rem;
            background-color: var(--primary-color);
            border-radius: 6px;
            border: 1px solid #404040;
        }

        .indicator-name {
            font-weight: 600;
        }

        .indicator-value {
            font-family: 'Courier New', monospace;
        }

        .signal-buy { color: var(--success-color); }
        .signal-sell { color: var(--danger-color); }
        .signal-neutral { color: var(--text-secondary); }

        .pattern-item {
            background-color: var(--primary-color);
            border-radius: 6px;
            padding: 1rem;
            margin-bottom: 0.5rem;
            border-left: 4px solid var(--info-color);
        }

        .pattern-name {
            font-weight: 600;
            color: var(--info-color);
        }

        .pattern-confidence {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .tabs {
            display: flex;
            border-bottom: 1px solid #404040;
            margin-bottom: 1rem;
        }

        .tab {
            padding: 0.75rem 1.5rem;
            cursor: pointer;
            border: none;
            background: none;
            color: var(--text-secondary);
            transition: all 0.3s ease;
        }

        .tab.active {
            color: var(--accent-color);
            border-bottom: 2px solid var(--accent-color);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        @media (max-width: 768px) {
            .container-fluid {
                padding: 0.5rem;
            }
            
            .chart-canvas {
                height: 300px;
            }
        }
    </style>
</head>
<body>
