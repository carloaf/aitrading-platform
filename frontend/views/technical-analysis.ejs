            <!-- Analysis Panel -->
            <div class="col-lg-4">
                <!-- Tabs -->
                <div class="tabs">
                    <button class="tab active" data-tab="indicators">Indicadores</button>
                    <button class="tab" data-tab="patterns">Padrões</button>
                    <button class="tab" data-tab="levels">Níveis</button>
                </div>

                <!-- Indicators Tab -->
                <div id="indicators-tab" class="tab-content active">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-chart-line me-2"></i>Valores Atuais
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="indicator-panel" id="indicatorValues">
                                <!-- Indicator values will be populated here -->
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-signal me-2"></i>Sinais de Trading
                            </h6>
                        </div>
                        <div class="card-body">
                            <div id="tradingSignals">
                                <!-- Trading signals will be populated here -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Patterns Tab -->
                <div id="patterns-tab" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-shapes me-2"></i>Padrões de Candlestick
                            </h6>
                        </div>
                        <div class="card-body">
                            <div id="candlestickPatterns">
                                <!-- Candlestick patterns will be populated here -->
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-chart-area me-2"></i>Padrões de Preço
                            </h6>
                        </div>
                        <div class="card-body">
