                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-chart-pie me-2"></i>Análise de Volume
                            </h6>
                        </div>
                        <div class="card-body">
                            <div id="volumeAnalysis">
