<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Paper Trading - AI Trading Platform</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --profit-color: #28a745;
            --loss-color: #dc3545;
            --neutral-color: #6c757d;
        }
        
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            color: #e9ecef;
        }
        
        .navbar {
            background: rgba(0,0,0,0.3) !important;
            backdrop-filter: blur(10px);
        }
        
        .metric-card {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            backdrop-filter: blur(10px);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .metric-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        
        .metric-value {
            font-size: 2.5rem;
            font-weight: bold;
            background: linear-gradient(135deg, #00d4ff, #00ff88);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .metric-value.profit {
            background: linear-gradient(135deg, #00ff88, #00d4ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .metric-value.loss {
            background: linear-gradient(135deg, #ff4444, #ff8800);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .metric-label {
            color: rgba(255,255,255,0.6);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }
        
        .chart-container {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            position: relative;
            height: 350px;
        }
        
        .chart-wrapper {
            position: relative;
            height: 280px;
            width: 100%;
        }
        
        .session-card {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }
        
        .session-card.active {
            border-color: #00ff88;
            box-shadow: 0 0 20px rgba(0,255,136,0.2);
        }
        
        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
        }
        
        .status-badge.running {
            background: rgba(0,255,136,0.2);
            color: #00ff88;
        }
        
        .status-badge.stopped {
            background: rgba(255,68,68,0.2);
            color: #ff4444;
        }
        
        .trade-row {
            background: rgba(255,255,255,0.03);
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 0.5rem;
            transition: background 0.2s ease;
        }
        
        .trade-row:hover {
            background: rgba(255,255,255,0.08);
        }
        
        .trade-buy { border-left: 3px solid #00ff88; }
        .trade-sell { border-left: 3px solid #ff4444; }
        
        .progress-ring {
            transform: rotate(-90deg);
        }
        
        .btn-glow {
            background: linear-gradient(135deg, #00d4ff, #00ff88);
            border: none;
            color: #1a1a2e;
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            border-radius: 50px;
            transition: box-shadow 0.3s ease, transform 0.2s ease;
        }
        
        .btn-glow:hover {
            box-shadow: 0 0 30px rgba(0,255,136,0.5);
            transform: scale(1.05);
            color: #1a1a2e;
        }
        
        .btn-danger-glow {
            background: linear-gradient(135deg, #ff4444, #ff8800);
        }
        
        .btn-danger-glow:hover {
            box-shadow: 0 0 30px rgba(255,68,68,0.5);
        }
        
        .pulse {
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        
        .update-indicator {
            width: 8px;
            height: 8px;
            background: #00ff88;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
        }
        
        .table-dark-custom {
            background: transparent;
        }
        
        .table-dark-custom th {
            color: rgba(255,255,255,0.6);
            font-weight: 500;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1px;
            border-color: rgba(255,255,255,0.1);
        }
        
        .table-dark-custom td {
            color: #e9ecef;
            border-color: rgba(255,255,255,0.05);
            vertical-align: middle;
        }
        
        .no-data {
            text-align: center;
            padding: 3rem;
            color: rgba(255,255,255,0.4);
        }
        
        .no-data i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="bi bi-graph-up-arrow"></i> AI Trading Platform
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="bi bi-house"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/signals"><i class="bi bi-activity"></i> Sinais</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/backtesting"><i class="bi bi-graph-up"></i> Backtesting</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/paper-trading"><i class="bi bi-play-circle"></i> Paper Trading</a>
                    </li>
                </ul>
                
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <span class="navbar-text">
                            <span class="update-indicator pulse"></span>
                            <span id="lastUpdate">Atualizando...</span>
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container-fluid py-4">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="mb-1">
                            <i class="bi bi-play-circle"></i> Paper Trading
                        </h1>
                        <p class="text-muted mb-0">Monitoramento em tempo real de estratégias</p>
                    </div>
                    <div>
                        <button class="btn btn-glow me-2" onclick="showStartModal()">
                            <i class="bi bi-plus-lg"></i> Nova Sessão
                        </button>
                        <button class="btn btn-outline-light" onclick="refreshData()">
                            <i class="bi bi-arrow-clockwise"></i> Atualizar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Market Regime Recommendation Widget -->
        <div class="row mb-4">
            <div class="col-12">
                <%- include('partials/market-regime-widget', { 
                    mode: 'recommendation',
                    symbol: 'BTCUSDT',
                    interval: '1h'
                }) %>
            </div>
        </div>

        <!-- Metrics Row -->
        <div class="row mb-4" id="metricsRow">
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">
                        <i class="bi bi-collection"></i> Sessões Ativas
                    </div>
                    <div class="metric-value" id="activeSessions">0</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">
                        <i class="bi bi-wallet2"></i> Balance Total
                    </div>
                    <div class="metric-value" id="totalBalance">$0.00</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">
                        <i class="bi bi-graph-up-arrow"></i> PnL Total
                    </div>
                    <div class="metric-value" id="totalPnL">$0.00</div>
                    <small id="totalPnLPercent" class="text-muted">0.00%</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">
                        <i class="bi bi-arrow-left-right"></i> Trades Executados
                    </div>
                    <div class="metric-value" id="totalTrades">0</div>
                </div>
            </div>
        </div>

        <!-- Main Content Row -->
        <div class="row">
            <!-- Sessions List -->
            <div class="col-lg-5">
                <div class="session-card">
                    <h5 class="mb-3">
                        <i class="bi bi-list-ul"></i> Sessões
                    </h5>
                    <div id="sessionsList">
                        <div class="no-data">
                            <i class="bi bi-inbox"></i>
                            <p>Nenhuma sessão ativa</p>
                            <button class="btn btn-glow btn-sm" onclick="showStartModal()">
                                Iniciar Sessão
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Session Details -->
                <div class="session-card" id="sessionDetails" style="display: none;">
                    <h5 class="mb-3">
                        <i class="bi bi-info-circle"></i> Detalhes da Sessão
                    </h5>
                    <div id="sessionDetailsContent"></div>
                </div>
            </div>

            <!-- Charts and Trades -->
            <div class="col-lg-7">
                <!-- Equity Chart -->
                <div class="chart-container">
                    <h5 class="mb-3">
                        <i class="bi bi-graph-up"></i> Curva de Equity
                    </h5>
                    <div class="chart-wrapper">
                        <canvas id="equityChart"></canvas>
                    </div>
                </div>
                
                <!-- Recent Trades -->
                <div class="session-card">
                    <h5 class="mb-3">
                        <i class="bi bi-clock-history"></i> Trades Recentes
                    </h5>
                    <div id="recentTrades">
                        <div class="no-data">
                            <i class="bi bi-hourglass"></i>
                            <p>Aguardando trades...</p>
                            <small class="text-muted">Trades aparecerão aqui quando executados</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Start Session Modal -->
    <div class="modal fade" id="startModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-light">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">
                        <i class="bi bi-plus-circle"></i> Nova Sessão de Paper Trading
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="startForm">
                        <div class="mb-3">
                            <label class="form-label">ID da Sessão</label>
                            <input type="text" class="form-control bg-dark text-light border-secondary" 
                                   id="sessionId" placeholder="ex: momentum_btc_001" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Estratégia</label>
                            <select class="form-select bg-dark text-light border-secondary" id="strategyName">
                                <option value="momentum">Momentum Strategy</option>
                                <option value="macd_rsi_combo">MACD + RSI Combo</option>
                                <option value="trend_following">Trend Following</option>
                                <option value="mean_reversion">Mean Reversion</option>
                                <option value="bollinger_bands">Bollinger Bands</option>
                                <option value="volatility_breakout">Volatility Breakout</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Símbolo</label>
                            <select class="form-select bg-dark text-light border-secondary" id="symbol">
                                <option value="BTCUSDT">BTC/USDT</option>
                                <option value="ETHUSDT">ETH/USDT</option>
                                <option value="BNBUSDT">BNB/USDT</option>
                                <option value="SOLUSDT">SOL/USDT</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Timeframe</label>
                            <select class="form-select bg-dark text-light border-secondary" id="timeframe">
                                <option value="1m">1 minuto</option>
                                <option value="5m">5 minutos</option>
                                <option value="15m">15 minutos</option>
                                <option value="1h">1 hora</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Capital Inicial ($)</label>
                            <input type="number" class="form-control bg-dark text-light border-secondary" 
                                   id="initialBalance" value="1000" min="100" step="100">
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-glow" onclick="startSession()">
                        <i class="bi bi-play-fill"></i> Iniciar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Configuration
        const API_URL = '<%= executionEngineUrl %>';
        let selectedSession = null;
        let equityChart = null;
        let refreshInterval = null;
        
        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            initChart();
            refreshData();
            startAutoRefresh();
        });
        
        // Auto refresh every 10 seconds
        function startAutoRefresh() {
            refreshInterval = setInterval(refreshData, 10000);
        }
        
        // Initialize equity chart
        function initChart() {
            const ctx = document.getElementById('equityChart').getContext('2d');
            equityChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Equity',
                        data: [],
                        borderColor: '#00ff88',
                        backgroundColor: 'rgba(0, 255, 136, 0.1)',
                        fill: true,
                        tension: 0.4,
                        pointRadius: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { color: 'rgba(255,255,255,0.5)' }
                        },
                        y: {
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { 
                                color: 'rgba(255,255,255,0.5)',
                                callback: value => '$' + value.toFixed(2)
                            }
                        }
                    }
                }
            });
        }
        
        // Refresh all data
        async function refreshData() {
            try {
                const response = await fetch(`${API_URL}/paper-trading/sessions`);
                const data = await response.json();
                
                updateMetrics(data);
                updateSessionsList(data.sessions);
                
                if (selectedSession) {
                    await loadSessionDetails(selectedSession);
                }
                
                document.getElementById('lastUpdate').textContent = 
                    'Atualizado: ' + new Date().toLocaleTimeString('pt-BR');
                    
            } catch (error) {
                console.error('Erro ao atualizar:', error);
                document.getElementById('lastUpdate').textContent = 'Erro ao atualizar';
            }
        }
        
        // Update metrics cards
        function updateMetrics(data) {
            document.getElementById('activeSessions').textContent = data.total_sessions || 0;
            
            let totalBalance = 0;
            let totalPnL = 0;
            let totalTrades = 0;
            
            if (data.sessions) {
                data.sessions.forEach(s => {
                    totalPnL += s.total_pnl || 0;
                    totalTrades += s.trades_executed || 0;
                });
            }
            
            const pnlElement = document.getElementById('totalPnL');
            pnlElement.textContent = '$' + totalPnL.toFixed(2);
            pnlElement.className = 'metric-value ' + (totalPnL >= 0 ? 'profit' : 'loss');
            
            document.getElementById('totalTrades').textContent = totalTrades;
        }
        
        // Update sessions list
        function updateSessionsList(sessions) {
            const container = document.getElementById('sessionsList');
            
            if (!sessions || sessions.length === 0) {
                container.innerHTML = `
                    <div class="no-data">
                        <i class="bi bi-inbox"></i>
                        <p>Nenhuma sessão ativa</p>
                        <button class="btn btn-glow btn-sm" onclick="showStartModal()">
                            Iniciar Sessão
                        </button>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = sessions.map(s => `
                <div class="trade-row ${selectedSession === s.session_id ? 'border border-success' : ''}" 
                     onclick="selectSession('${s.session_id}')" style="cursor: pointer;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>${s.session_id}</strong>
                            <br>
                            <small class="text-muted">${s.strategy} • ${s.symbol}</small>
                        </div>
                        <div class="text-end">
                            <span class="status-badge ${s.is_running ? 'running' : 'stopped'}">
                                <i class="bi bi-${s.is_running ? 'play-fill' : 'pause-fill'} me-1"></i>
                                ${s.is_running ? 'Rodando' : 'Parado'}
                            </span>
                            <br>
                            <small class="${s.total_pnl >= 0 ? 'text-success' : 'text-danger'}">
                                ${s.total_pnl >= 0 ? '+' : ''}$${(s.total_pnl || 0).toFixed(2)}
                            </small>
                        </div>
                    </div>
                </div>
            `).join('');
        }
        
        // Select session
        async function selectSession(sessionId) {
            selectedSession = sessionId;
            document.getElementById('sessionDetails').style.display = 'block';
            await loadSessionDetails(sessionId);
            refreshData();
        }
        
        // Load session details
        async function loadSessionDetails(sessionId) {
            try {
                const [statusRes, tradesRes] = await Promise.all([
                    fetch(`${API_URL}/paper-trading/${sessionId}/status`),
                    fetch(`${API_URL}/paper-trading/${sessionId}/trades?limit=20`)
                ]);
                
                const status = await statusRes.json();
                const trades = await tradesRes.json();
                
                updateSessionDetailsUI(status);
                updateTradesUI(trades);
                updateChart(trades, status.account_summary?.balance || 1000);
                
            } catch (error) {
                console.error('Erro ao carregar detalhes:', error);
            }
        }
        
        // Update session details UI
        function updateSessionDetailsUI(status) {
            const uptimeMin = Math.floor((status.uptime_seconds || 0) / 60);
            const pnl = status.account_summary?.total_pnl || 0;
            const pnlPct = status.account_summary?.total_pnl_percent || 0;
            
            document.getElementById('sessionDetailsContent').innerHTML = `
                <div class="row">
                    <div class="col-6 mb-3">
                        <small class="text-muted">Estratégia</small>
                        <div>${status.strategy_name || 'N/A'}</div>
                    </div>
                    <div class="col-6 mb-3">
                        <small class="text-muted">Símbolo</small>
                        <div>${status.symbol || 'N/A'}</div>
                    </div>
                    <div class="col-6 mb-3">
                        <small class="text-muted">Uptime</small>
                        <div>${uptimeMin} minutos</div>
                    </div>
                    <div class="col-6 mb-3">
                        <small class="text-muted">Candles</small>
                        <div>${status.candles_collected || 0} / 50</div>
                    </div>
                    <div class="col-6 mb-3">
                        <small class="text-muted">Sinais</small>
                        <div>${status.signals_generated || 0}</div>
                    </div>
                    <div class="col-6 mb-3">
                        <small class="text-muted">Trades</small>
                        <div>${status.trades_executed || 0}</div>
                    </div>
                    <div class="col-6 mb-3">
                        <small class="text-muted">Balance</small>
                        <div>$${(status.account_summary?.balance || 1000).toFixed(2)}</div>
                    </div>
                    <div class="col-6 mb-3">
                        <small class="text-muted">PnL</small>
                        <div class="${pnl >= 0 ? 'text-success' : 'text-danger'}">
                            ${pnl >= 0 ? '+' : ''}$${pnl.toFixed(2)} (${pnlPct.toFixed(2)}%)
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-danger-glow btn-sm w-100" onclick="stopSession('${selectedSession}')">
                        <i class="bi bi-stop-fill"></i> Parar Sessão
                    </button>
                </div>
            `;
            
            // Update total balance
            document.getElementById('totalBalance').textContent = 
                '$' + (status.account_summary?.balance || 1000).toFixed(2);
        }
        
        // Update trades UI
        function updateTradesUI(trades) {
            const container = document.getElementById('recentTrades');
            
            if (!trades || trades.length === 0) {
                container.innerHTML = `
                    <div class="no-data">
                        <i class="bi bi-hourglass"></i>
                        <p>Aguardando trades...</p>
                        <small class="text-muted">Trades aparecerão aqui quando executados</small>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = trades.slice(0, 10).map(t => `
                <div class="trade-row trade-${t.side?.toLowerCase()}">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-${t.side === 'BUY' ? 'success' : 'danger'}">
                                ${t.side}
                            </span>
                            <span class="ms-2">${t.quantity?.toFixed(6)} @ $${t.price?.toFixed(2)}</span>
                        </div>
                        <div class="text-end">
                            <span class="${(t.pnl || 0) >= 0 ? 'text-success' : 'text-danger'}">
                                ${(t.pnl || 0) >= 0 ? '+' : ''}$${(t.pnl || 0).toFixed(2)}
                            </span>
                            <br>
                            <small class="text-muted">${new Date(t.timestamp).toLocaleTimeString('pt-BR')}</small>
                        </div>
                    </div>
                </div>
            `).join('');
        }
        
        // Update chart
        function updateChart(trades, currentBalance) {
            if (!equityChart) return;
            
            // Build equity curve from trades
            const equityCurve = [{ time: 'Início', value: 1000 }];
            let balance = 1000;
            
            if (trades && trades.length > 0) {
                trades.forEach((t, i) => {
                    balance = t.balance_after || balance + (t.pnl || 0);
                    equityCurve.push({
                        time: new Date(t.timestamp).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }),
                        value: balance
                    });
                });
            }
            
            // Add current balance
            equityCurve.push({ time: 'Agora', value: currentBalance });
            
            equityChart.data.labels = equityCurve.map(e => e.time);
            equityChart.data.datasets[0].data = equityCurve.map(e => e.value);
            
            // Update chart color based on performance
            const isProfit = currentBalance >= 1000;
            equityChart.data.datasets[0].borderColor = isProfit ? '#00ff88' : '#ff4444';
            equityChart.data.datasets[0].backgroundColor = isProfit ? 'rgba(0, 255, 136, 0.1)' : 'rgba(255, 68, 68, 0.1)';
            
            equityChart.update('none');
        }
        
        // Show start modal
        function showStartModal() {
            const modal = new bootstrap.Modal(document.getElementById('startModal'));
            document.getElementById('sessionId').value = 'session_' + Date.now();
            modal.show();
        }
        
        // Start session
        async function startSession() {
            const sessionId = document.getElementById('sessionId').value;
            const strategyName = document.getElementById('strategyName').value;
            const symbol = document.getElementById('symbol').value;
            const timeframe = document.getElementById('timeframe').value;
            const initialBalance = parseFloat(document.getElementById('initialBalance').value);
            
            try {
                const response = await fetch(`${API_URL}/paper-trading/start`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        session_id: sessionId,
                        strategy_name: strategyName,
                        strategy_parameters: {},
                        symbol: symbol,
                        timeframe: timeframe,
                        initial_balance: initialBalance
                    })
                });
                
                const result = await response.json();
                
                if (response.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('startModal')).hide();
                    selectedSession = sessionId;
                    refreshData();
                    alert('Sessão iniciada com sucesso!');
                } else {
                    alert('Erro: ' + (result.detail || 'Falha ao iniciar sessão'));
                }
            } catch (error) {
                console.error('Erro:', error);
                alert('Erro de conexão com o servidor');
            }
        }
        
        // Stop session
        async function stopSession(sessionId) {
            if (!confirm('Tem certeza que deseja parar esta sessão?')) return;
            
            try {
                const response = await fetch(`${API_URL}/paper-trading/${sessionId}/stop`, {
                    method: 'POST'
                });
                
                if (response.ok) {
                    refreshData();
                    alert('Sessão parada com sucesso!');
                } else {
                    alert('Erro ao parar sessão');
                }
            } catch (error) {
                console.error('Erro:', error);
                alert('Erro de conexão');
            }
        }
    </script>
</body>
</html>
