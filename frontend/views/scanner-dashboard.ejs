                                </button>
                                <button type="button" class="btn btn-outline-warning btn-sm" onclick="selectTopSymbols()">
                                    <i class="bi bi-star-fill"></i> Top 10
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm" onclick="selectTop30()">
