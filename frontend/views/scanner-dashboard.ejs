    // Função separada para renderizar Near Alerts (usada por cache e API)
    function renderNearAlerts(data, fromCache = false) {
        const container = document.getElementById('nearAlertsRow');
        if (!container) return;
        
        let html = '';
        
        // Mostrar apenas os que têm proximidade > 0 ou RSI extremo
        const alertData = data.filter(item => 
            item.proximity > 0 || item.rsi <= 35 || item.rsi >= 65
        ).slice(0, 6);
        
        // Indicador de cache
        const cacheIndicator = fromCache ? '<span class="badge bg-secondary ms-2" title="Dados do cache"><i class="bi bi-clock-history"></i></span>' : '';
        
        if (alertData.length === 0) {
            html = \`
                <div class="col-12 text-center text-muted py-4">
                    <i class="bi bi-check-circle display-4 d-block mb-2 text-success"></i>
                    <p>Nenhuma divergência em formação no momento \${cacheIndicator}</p>
                    <small>RSI de todos os ativos está na faixa neutra (35-65)</small>
                </div>
            \`;
        } else {
            alertData.forEach(item => {
                const proximityColor = item.proximity >= 70 ? 'danger' : (item.proximity >= 40 ? 'warning' : 'secondary');
                
                // Definir status e descrição com base na proximidade e RSI
                let statusText = '';
                let statusIcon = '';
                let statusDescription = '';
                
                if (item.trend === 'forming_bullish') {
                    statusText = '🟢 Possível Bullish Div.';
                    statusIcon = 'arrow-up-circle';
                    statusDescription = 'RSI subindo enquanto preço pode estar caindo';
                } else if (item.trend === 'forming_bearish') {
                    statusText = '🔴 Possível Bearish Div.';
                    statusIcon = 'arrow-down-circle';
                    statusDescription = 'RSI caindo enquanto preço pode estar subindo';
                } else if (item.trend === 'watching_bullish' || item.rsi <= 35) {
                    statusText = '👀 RSI Baixo - Atenção';
                    statusIcon = 'eye';
                    statusDescription = 'Zona de sobrevenda, potencial reversão de alta';
                } else if (item.trend === 'watching_bearish' || item.rsi >= 65) {
                    statusText = '👀 RSI Alto - Atenção';
                    statusIcon = 'eye';
                    statusDescription = 'Zona de sobrecompra, potencial reversão de baixa';
                } else {
                    statusText = '📊 Monitorando';
                    statusIcon = 'hourglass-split';
                    statusDescription = 'Avaliando condições de mercado';
                }
                
                // Calcular nível de urgência
                let urgencyBadge = '';
                if (item.proximity >= 70) {
                    urgencyBadge = '<span class="badge bg-danger pulse-animation">IMINENTE</span>';
                } else if (item.proximity >= 40) {
                    urgencyBadge = '<span class="badge bg-warning text-dark">FORMANDO</span>';
                } else if (item.proximity > 0) {
                    urgencyBadge = '<span class="badge bg-secondary">OBSERVANDO</span>';
                }
                
                const cardClass = item.proximity >= 70 ? 'near-alert-card forming' : 'near-alert-card';
                const changeClass = item.change_24h >= 0 ? 'text-success' : 'text-danger';
                const changeIcon = item.change_24h >= 0 ? 'caret-up-fill' : 'caret-down-fill';
                
                html += \`
                    <div class="col-md-4 mb-3">
                        <div class="card \${cardClass} h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="mb-0 fw-bold">\${item.symbol}</h6>
                                        <small class="text-muted">\${formatPrice(item.price)}</small>
                                    </div>
                                    <div class="text-end">
                                        \${urgencyBadge}
                                        \${item.proximity > 0 ? \`<div class="small text-\${proximityColor} fw-bold mt-1">\${item.proximity}% próximo</div>\` : ''}
                                    </div>
                                </div>
                                
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between align-items-center small mb-1">
                                        <span class="text-muted">RSI</span>
                                        <span class="\${item.rsi < 35 ? 'text-success fw-bold' : (item.rsi > 65 ? 'text-danger fw-bold' : 'text-muted')}">\${item.rsi.toFixed(1)}</span>
                                    </div>
                                    <div class="rsi-gauge">
                                        <div class="rsi-marker" style="left: \${item.rsi}%;"></div>
                                    </div>
                                    <div class="d-flex justify-content-between small text-muted mt-1">
                                        <span>30</span>
                                        <span>50</span>
                                        <span>70</span>
                                    </div>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-center small mb-2">
                                    <span>24h:</span>
                                    <span class="\${changeClass} fw-bold">
                                        <i class="bi bi-\${changeIcon}"></i> \${Math.abs(item.change_24h).toFixed(2)}%
                                    </span>
                                </div>
                                
                                <div class="border-top pt-2 mt-2">
                                    <p class="mb-1 small fw-bold text-\${proximityColor === 'danger' ? 'danger' : (proximityColor === 'warning' ? 'warning' : 'secondary')}">
                                        <i class="bi bi-\${statusIcon}"></i> \${statusText}
                                    </p>
                                    <p class="mb-0 small text-muted">\${statusDescription}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                \`;
            });
        }
        
        container.innerHTML = html;
    }
    
    async function updateNearAlerts() {
        const container = document.getElementById('nearAlertsRow');
        
        try {
            // Fetch real market data from API
            const symbols = getSelectedSymbols().map(s => s.replace('/', '')).join(',');
            const response = await fetch(API_BASE + '/api/scanner/market-data?symbols=' + symbols);
            const result = await response.json();
            
            if (!result.success || !result.data || result.data.length === 0) {
                // Não sobrescrever se já tem dados do cache
                if (container.innerHTML.includes('col-md-4')) {
                    console.log('[NearAlerts] API falhou mas tem cache, mantendo');
                    return;
                }
                container.innerHTML = \`
                    <div class="col-12 text-center text-muted py-4">
                        <i class="bi bi-wifi-off display-4 d-block mb-2"></i>
                        <p>Aguardando dados do mercado...</p>
                    </div>
                \`;
                return;
            }
            
            // Salvar no cache para próximo refresh
            saveNearAlertsCache(result.data);
            
            // Renderizar dados frescos
            renderNearAlerts(result.data, false);
            
        } catch (error) {
            console.error('Error updating near alerts:', error);
            // Não sobrescrever se já tem dados do cache
            if (container.innerHTML.includes('col-md-4')) {
                console.log('[NearAlerts] Erro mas tem cache, mantendo');
                return;
            }
            container.innerHTML = \`
                <div class="col-12 text-center text-danger py-4">
                    <i class="bi bi-exclamation-triangle display-4 d-block mb-2"></i>
                    <p>Erro ao carregar dados: \${error.message}</p>
                </div>
            \`;
        }
    }
    
