<%- include('layout', { body: `
<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">
                <i class="bi bi-radar text-primary"></i> RSI Divergence Scanner
            </h1>
            <p class="text-muted mb-0">Monitoramento em tempo real de divergências RSI em múltiplas criptos</p>
        </div>
        <div>
            <span id="lastScan" class="text-muted me-3">
                <i class="bi bi-clock"></i> Último scan: --
            </span>
            <button class="btn btn-success btn-sm me-2" onclick="runScan()" id="btnScan">
                <i class="bi bi-search"></i> Scan Agora
            </button>
            <button class="btn btn-outline-primary btn-sm" onclick="toggleContinuousScan()" id="btnContinuous">
                <i class="bi bi-play-circle"></i> Iniciar Contínuo
            </button>
        </div>
    </div>

    <!-- Alerts Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div id="alertsContainer">
                <!-- Alerts will be dynamically inserted here -->
            </div>
        </div>
    </div>

    <!-- Active Signals Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-bell-fill"></i> Sinais Ativos de RSI Divergence
                        <span id="signalCount" class="badge bg-dark ms-2">0</span>
                    </h5>
                    <div>
                        <span id="scannerStatus" class="badge bg-secondary me-2">Parado</span>
                        <span id="symbolsMonitored" class="text-dark">0 símbolos</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="signalsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Símbolo</th>
                                    <th>Tipo</th>
                                    <th>Direção</th>
                                    <th>Força</th>
                                    <th>RSI</th>
                                    <th>Preço Atual</th>
                                    <th>Entrada</th>
                                    <th>Stop Loss</th>
                                    <th>Take Profit</th>
                                    <th>R/R</th>
                                    <th>Confirmações</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="signalsTableBody">
                                <tr>
                                    <td colspan="12" class="text-center text-muted py-5">
                                        <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                        <p>Nenhum sinal detectado. Execute um scan para começar.</p>
                                        <button class="btn btn-primary btn-sm" onclick="runScan()">
                                            <i class="bi bi-search"></i> Executar Scan
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Configuration & Near Alerts Row -->
    <div class="row mb-4">
        <!-- Scanner Configuration -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
