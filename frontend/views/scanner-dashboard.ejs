<script>
    // State
    let isContinuousRunning = false;
    let scanInterval = null;
    let signalHistory = [];
    let nearAlerts = {};
    
    // API base URL - execution-engine runs on port 3008
    // Use o mesmo hostname que o browser está acessando (para evitar problemas de CORS)
    const API_BASE = window.location.hostname === 'localhost' 
        ? 'http://localhost:3008' 
        : \`http://\${window.location.hostname}:3008\`;
    const STORAGE_KEY = 'scannerConfig';
    const STATE_KEY = 'scannerState';  // Para persistir estado de execução
    const AUTOTRADE_STATE_KEY = 'autotradeState';  // Para persistir estado do AutoTrade
    const NEAR_ALERTS_KEY = 'nearAlertsCache';  // Cache para Proximidade de Alerta
    const MARKET_DATA_KEY = 'marketDataCache';  // Cache para Market Overview
    
    // Debug: log API base
    console.log('[Scanner] API_BASE:', API_BASE);
    console.log('[Scanner] window.location.hostname:', window.location.hostname);
    
    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadSavedConfig();  // Load saved config first
        loadSavedState();   // Load execution state (continuous scan, etc)
        initializeScanner();
        
        // Restaurar cache primeiro (instantâneo), depois atualiza em background
        restoreNearAlertsCache();
        restoreMarketDataCache();
        
        // Atualiza dados em background (não bloqueia UI)
        setTimeout(() => {
            fetchMarketData();
            updateNearAlerts();
        }, 500);
        
        // Auto-refresh market data every 30 seconds
        setInterval(fetchMarketData, 30000);
        setInterval(updateNearAlerts, 15000);
        
        // Add auto-save event listeners to all config inputs
        setupAutoSave();
    });
    
    // Save execution state to localStorage
    function saveState() {
        const state = {
            isContinuousRunning: isContinuousRunning,
            scanIntervalValue: document.getElementById('scanInterval')?.value || 60
        };
        localStorage.setItem(STATE_KEY, JSON.stringify(state));
    }
    
    // Load execution state from localStorage
    function loadSavedState() {
        const savedState = localStorage.getItem(STATE_KEY);
        if (!savedState) return;
        
        try {
            const state = JSON.parse(savedState);
            // Restore saved interval value before toggling
            if (state.scanIntervalValue) {
                const intervalInput = document.getElementById('scanInterval');
                if (intervalInput) {
                    intervalInput.value = state.scanIntervalValue;
                    document.getElementById('intervalValue').textContent = state.scanIntervalValue;
                }
            }
            
            // Restore continuous scan if it was running
            if (state.isContinuousRunning) {
                console.log('Restoring continuous scan from saved state...');
                // Small delay to let page load first
                setTimeout(() => {
                    if (!isContinuousRunning) {
                        toggleContinuousScan();
                    }
                }, 1500);
            }
        } catch (e) {
            console.error('Error loading saved state:', e);
        }
    }
    
    // ========================================
    // CACHE PARA PROXIMIDADE DE ALERTA
    // ========================================
    
    // Salvar cache de Near Alerts
    function saveNearAlertsCache(data) {
        try {
            const cache = {
                data: data,
                timestamp: Date.now()
            };
            localStorage.setItem(NEAR_ALERTS_KEY, JSON.stringify(cache));
            console.log('[Cache] Near Alerts salvo:', data.length, 'itens');
        } catch (e) {
            console.warn('[Cache] Erro ao salvar Near Alerts:', e);
        }
    }
    
    // Restaurar cache de Near Alerts (instantâneo)
    function restoreNearAlertsCache() {
        const container = document.getElementById('nearAlertsRow');
        const cached = localStorage.getItem(NEAR_ALERTS_KEY);
        
        if (!cached) {
            console.log('[Cache] Nenhum cache de Near Alerts encontrado');
            return;
        }
        
        try {
            const { data, timestamp } = JSON.parse(cached);
            const ageMinutes = (Date.now() - timestamp) / 60000;
            
            // Cache válido por 5 minutos
            if (ageMinutes > 5) {
                console.log('[Cache] Near Alerts expirado (' + ageMinutes.toFixed(1) + ' min)');
                return;
            }
            
            console.log('[Cache] Restaurando Near Alerts (idade: ' + ageMinutes.toFixed(1) + ' min)');
            
            // Renderizar imediatamente com dados do cache
            renderNearAlerts(data, true);
            
        } catch (e) {
            console.warn('[Cache] Erro ao restaurar Near Alerts:', e);
        }
    }
    
    // Salvar cache de Market Data
    function saveMarketDataCache(data) {
        try {
            const cache = {
                data: data,
                timestamp: Date.now()
            };
            localStorage.setItem(MARKET_DATA_KEY, JSON.stringify(cache));
            console.log('[Cache] Market Data salvo:', data.length, 'itens');
        } catch (e) {
            console.warn('[Cache] Erro ao salvar Market Data:', e);
        }
    }
    
    // Restaurar cache de Market Data (instantâneo)
    function restoreMarketDataCache() {
        const container = document.getElementById('marketOverview');
        const cached = localStorage.getItem(MARKET_DATA_KEY);
        
        if (!cached) {
            console.log('[Cache] Nenhum cache de Market Data encontrado');
            return;
        }
        
        try {
            const { data, timestamp } = JSON.parse(cached);
            const ageMinutes = (Date.now() - timestamp) / 60000;
            
            // Cache válido por 5 minutos
            if (ageMinutes > 5) {
                console.log('[Cache] Market Data expirado (' + ageMinutes.toFixed(1) + ' min)');
                return;
            }
            
            console.log('[Cache] Restaurando Market Data (idade: ' + ageMinutes.toFixed(1) + ' min)');
            
            // Renderizar imediatamente com dados do cache
            renderMarketOverview(data, true);
            
        } catch (e) {
            console.warn('[Cache] Erro ao restaurar Market Data:', e);
        }
    }
    
    // Setup auto-save for all configuration inputs
    function setupAutoSave() {
        // Auto-save when symbols checkboxes change
        document.querySelectorAll('#scannerConfigForm input[type="checkbox"]').forEach(cb => {
            cb.addEventListener('change', function() {
                saveConfig();
                console.log('Config auto-saved after checkbox change');
            });
        });
        
        // Auto-save when range sliders change
        document.querySelectorAll('#scannerConfigForm input[type="range"]').forEach(range => {
            range.addEventListener('change', function() {
                saveConfig();
                console.log('Config auto-saved after range change');
            });
        });
        
        // Auto-save AutoTrade settings
        const autotradeDryRun = document.getElementById('autotradeDryRun');
        if (autotradeDryRun) {
            autotradeDryRun.addEventListener('change', function() {
                saveConfig();
                // Update label
                const label = document.getElementById('dryRunLabel');
                if (label) {
                    label.textContent = this.checked ? '🔴 DRY RUN (Simulação)' : '🟢 LIVE (Execução Real)';
                }
                console.log('AutoTrade DryRun saved:', this.checked);
            });
        }
        
        const autotradeMinStrength = document.getElementById('autotradeMinStrength');
        if (autotradeMinStrength) {
            autotradeMinStrength.addEventListener('change', function() {
                saveConfig();
                console.log('AutoTrade MinStrength saved:', this.value);
            });
        }
        
        const autotradeCapital = document.getElementById('autotradeCapital');
        if (autotradeCapital) {
            autotradeCapital.addEventListener('change', function() {
                saveConfig();
                console.log('AutoTrade Capital saved:', this.value);
            });
        }
    }
    
    // Save configuration to localStorage
    function saveConfig() {
        const config = {
            symbols: [],
            timeframes: [],
            minStrength: document.getElementById('minStrength').value,
            scanInterval: document.getElementById('scanInterval').value,
            useEmaFilter: document.getElementById('useEmaFilter').checked,  // NOVO v2.1
            // AutoTrade settings
            autotradeDryRun: document.getElementById('autotradeDryRun')?.checked ?? true,
            autotradeMinStrength: document.getElementById('autotradeMinStrength')?.value || '0.5',
            autotradeCapital: document.getElementById('autotradeCapital')?.value || '10000'
        };
        
        // Get selected symbols (using new class-based selector)
        document.querySelectorAll('.symbol-check').forEach(cb => {
            config.symbols.push({ id: cb.id, checked: cb.checked });
        });
        
        // Get timeframes
        ['1h', '4h', '1d'].forEach(tf => {
            const cb = document.getElementById('chk' + tf);
            if (cb) {
                config.timeframes.push({ id: cb.id, value: cb.value, checked: cb.checked });
            }
        });
        
        localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
        console.log('Config saved:', config.symbols.filter(s => s.checked).length + ' symbols selected');
    }
    
    // Load configuration from localStorage
    function loadSavedConfig() {
        const savedConfig = localStorage.getItem(STORAGE_KEY);
        if (!savedConfig) {
            console.log('No saved config found, using defaults');
            updateSymbolCount();
            return;
        }
        
        try {
            const config = JSON.parse(savedConfig);
            console.log('Loading saved config:', config.symbols?.filter(s => s.checked).length + ' symbols');
            
            // Restore symbols checkboxes
            if (config.symbols && config.symbols.length > 0) {
                // First, uncheck all symbols
                document.querySelectorAll('.symbol-check').forEach(cb => cb.checked = false);
                // Then restore saved state
                config.symbols.forEach(item => {
                    const cb = document.getElementById(item.id);
                    if (cb) cb.checked = item.checked;
                });
            }
            
            // Restore timeframes checkboxes
            if (config.timeframes && config.timeframes.length > 0) {
                config.timeframes.forEach(item => {
                    const cb = document.getElementById(item.id);
                    if (cb) cb.checked = item.checked;
                });
            }
            
            // Restore minStrength
            if (config.minStrength) {
                document.getElementById('minStrength').value = config.minStrength;
                document.getElementById('strengthValue').textContent = config.minStrength;
            }
            
            // Restore useEmaFilter (NOVO v2.1)
            if (config.useEmaFilter !== undefined) {
                document.getElementById('useEmaFilter').checked = config.useEmaFilter;
            }
            
            // Restore scanInterval
            if (config.scanInterval) {
                document.getElementById('scanInterval').value = config.scanInterval;
                document.getElementById('intervalValue').textContent = config.scanInterval;
            }
            
            // Restore AutoTrade settings
            if (config.autotradeDryRun !== undefined) {
                const dryRunCb = document.getElementById('autotradeDryRun');
                if (dryRunCb) {
                    dryRunCb.checked = config.autotradeDryRun;
                    // Update label
                    const label = document.getElementById('dryRunLabel');
                    if (label) {
                        label.textContent = config.autotradeDryRun ? '🔴 DRY RUN (Simulação)' : '🟢 LIVE (Execução Real)';
                    }
                }
            }
            if (config.autotradeMinStrength) {
                const strengthInput = document.getElementById('autotradeMinStrength');
                if (strengthInput) {
                    strengthInput.value = config.autotradeMinStrength;
                    document.getElementById('autotradeStrengthVal').textContent = config.autotradeMinStrength;
                }
            }
            if (config.autotradeCapital) {
                const capitalInput = document.getElementById('autotradeCapital');
                if (capitalInput) {
                    capitalInput.value = config.autotradeCapital;
                }
            }
            
            // Update symbol count after loading
            updateSymbolCount();
        } catch (e) {
            console.error('Error loading saved config:', e);
        }
    }
    
    async function initializeScanner() {
        try {
            const symbols = getSelectedSymbols();
            const timeframes = getSelectedTimeframes();
            
            const response = await fetch(API_BASE + '/api/scanner/init', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    symbols: symbols,
                    timeframes: timeframes,
                    min_signal_strength: parseFloat(document.getElementById('minStrength').value),
                    use_ema_filter: document.getElementById('useEmaFilter').checked  // NOVO v2.1
                })
            });
            
            const data = await response.json();
            if (data.success) {
                document.getElementById('symbolsMonitored').textContent = data.config.symbols.length + ' símbolos';
                showToast('Scanner Inicializado', 'Monitorando ' + data.config.symbols.length + ' símbolos', 'success');
            }
        } catch (error) {
            console.error('Error initializing scanner:', error);
            showToast('Erro', 'Falha ao inicializar scanner', 'danger');
        }
    }
    
    async function runScan() {
        const btn = document.getElementById('btnScan');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Escaneando...';
        
        try {
            const symbols = getSelectedSymbols();
            const timeframes = getSelectedTimeframes();
            
            const response = await fetch(API_BASE + '/api/scanner/scan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ symbols, timeframes })
            });
            
            const data = await response.json();
            
            if (data.success) {
                updateSignalsTable(data.signals);
                updateLastScan(data.last_scan_time);
                document.getElementById('signalCount').textContent = data.signals_found;
                
                // Add to history
                if (data.signals && data.signals.length > 0) {
                    addToHistory(data.signals);
                    playAlertSound();
                    showSignalAlerts(data.signals);
                    
                    // Send signals to AutoTrade if active (100% local processing)
                    for (const signal of data.signals) {
                        processSignalLocally(signal);
                    }
                }
                
                showToast('Scan Completo', 
                    'Encontrados ' + data.signals_found + ' sinais em ' + data.symbols_scanned + ' símbolos', 
                    data.signals_found > 0 ? 'warning' : 'info');
            }
        } catch (error) {
            console.error('Error running scan:', error);
            showToast('Erro', 'Falha ao executar scan', 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-search"></i> Scan Agora';
        }
    }
    
    function toggleContinuousScan() {
        const btn = document.getElementById('btnContinuous');
        const statusBadge = document.getElementById('scannerStatus');
        
        if (isContinuousRunning) {
            // Stop
            clearInterval(scanInterval);
            isContinuousRunning = false;
            btn.innerHTML = '<i class="bi bi-play-circle"></i> Iniciar Contínuo';
            btn.classList.remove('btn-danger');
            btn.classList.add('btn-outline-primary');
            statusBadge.textContent = 'Parado';
            statusBadge.classList.remove('bg-success');
            statusBadge.classList.add('bg-secondary');
            showToast('Scanner Parado', 'Monitoramento contínuo desativado', 'info');
            saveState();  // Persist state
        } else {
            // Start
            const interval = parseInt(document.getElementById('scanInterval').value) * 1000;
            runScan(); // Run immediately
            scanInterval = setInterval(runScan, interval);
            isContinuousRunning = true;
            btn.innerHTML = '<i class="bi bi-stop-circle"></i> Parar';
            btn.classList.remove('btn-outline-primary');
            btn.classList.add('btn-danger');
            statusBadge.textContent = 'Rodando';
            statusBadge.classList.remove('bg-secondary');
            statusBadge.classList.add('bg-success');
            showToast('Scanner Iniciado', 'Escaneando a cada ' + (interval/1000) + ' segundos', 'success');
            saveState();  // Persist state
        }
    }
    
    function updateSignalsTable(signals) {
        const tbody = document.getElementById('signalsTableBody');
        
        if (!signals || signals.length === 0) {
            tbody.innerHTML = \`
                <tr>
                    <td colspan="12" class="text-center text-muted py-5">
                        <i class="bi bi-check-circle display-4 d-block mb-3 text-success"></i>
                        <p>Nenhuma divergência RSI detectada no momento.</p>
                        <small>O scanner continua monitorando...</small>
                    </td>
                </tr>
            \`;
            return;
        }
        
        let html = '';
        signals.forEach(signal => {
            const rowClass = signal.direction === 'BUY' ? 'signal-bullish' : 'signal-bearish';
            const directionBadge = signal.direction === 'BUY' 
                ? '<span class="badge bg-success"><i class="bi bi-arrow-up"></i> COMPRA</span>'
                : '<span class="badge bg-danger"><i class="bi bi-arrow-down"></i> VENDA</span>';
            
            const strengthClass = signal.strength >= 0.7 ? 'text-success' : (signal.strength >= 0.5 ? 'text-warning' : 'text-danger');
            
            const confirmations = [];
            if (signal.confirmations.volume) confirmations.push('<span class="badge badge-confirmed confirmation-badge">Vol</span>');
            else confirmations.push('<span class="badge badge-unconfirmed confirmation-badge">Vol</span>');
            if (signal.confirmations.macd) confirmations.push('<span class="badge badge-confirmed confirmation-badge">MACD</span>');
            else confirmations.push('<span class="badge badge-unconfirmed confirmation-badge">MACD</span>');
            if (signal.confirmations.trend) confirmations.push('<span class="badge badge-confirmed confirmation-badge">Trend</span>');
            else confirmations.push('<span class="badge badge-unconfirmed confirmation-badge">Trend</span>');
            
            html += \`
                <tr class="\${rowClass}">
                    <td><strong>\${signal.symbol}</strong></td>
                    <td>
                        <span class="badge bg-info">\${formatSignalType(signal.type)}</span>
                        <br><small class="text-muted">\${signal.timeframe}</small>
                    </td>
                    <td>\${directionBadge}</td>
                    <td class="\${strengthClass}">
                        <strong>\${(signal.strength * 100).toFixed(0)}%</strong>
                        <br><small>\${signal.strength_level}</small>
                    </td>
                    <td>
                        <div class="rsi-gauge" style="width: 80px;">
                            <div class="rsi-marker" style="left: \${signal.rsi}%;"></div>
                        </div>
                        <small>\${signal.rsi.toFixed(1)}</small>
                    </td>
                    <td>\${formatPrice(signal.price)}</td>
                    <td class="text-primary fw-bold">\${formatPrice(signal.entry)}</td>
                    <td class="text-danger">\${formatPrice(signal.stop_loss)}</td>
                    <td class="text-success">\${formatPrice(signal.take_profit)}</td>
                    <td><span class="badge bg-secondary">\${signal.risk_reward.toFixed(1)}:1</span></td>
                    <td>\${confirmations.join(' ')}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-success" onclick="openPaperTrade('\${signal.symbol}', '\${signal.direction}', \${signal.entry})">
                            <i class="bi bi-play-circle"></i> Paper
                        </button>
                    </td>
                </tr>
            \`;
        });
        
        tbody.innerHTML = html;
    }
    
    function showSignalAlerts(signals) {
        const container = document.getElementById('alertsContainer');
        let html = '';
        
        signals.forEach(signal => {
