    async function fetchMarketData() {
        const container = document.getElementById('marketOverview');
        
        try {
            const symbols = getSelectedSymbols().map(s => s.replace('/', '')).slice(0, 6).join(',');
            const response = await fetch(API_BASE + '/api/scanner/market-data?symbols=' + symbols);
            const result = await response.json();
            
            if (!result.success || !result.data) {
                throw new Error('Falha ao buscar dados');
            }
            
            // Salvar no cache para próximo refresh
            saveMarketDataCache(result.data);
            
            // Verificar se container está vazio (primeira carga) ou estrutura mudou
            const currentSymbols = result.data.map(c => c.symbol).join(',');
            const cachedSymbols = Object.keys(lastMarketData).join(',');
            const needsFullRebuild = container.children.length === 0 || currentSymbols !== cachedSymbols;
            
            if (needsFullRebuild) {
                // Primeira carga ou símbolos mudaram - rebuild completo
                renderMarketOverview(result.data, false);
            } else {
                // Atualização incremental - só mudar valores que mudaram
                let updatedCount = 0;
                
                result.data.forEach(coin => {
                    const symbolId = coin.symbol.replace('/', '').replace('USDT', '');
                    const cached = lastMarketData[coin.symbol];
                    
                    if (!cached) return;
                    
                    // Atualizar preço se mudou
                    if (cached.price !== coin.price) {
                        const priceEl = document.getElementById('price-' + symbolId);
                        if (priceEl) {
                            priceEl.textContent = formatPrice(coin.price);
                            // Flash animation para indicar mudança
                            priceEl.classList.add('price-flash');
                            setTimeout(() => priceEl.classList.remove('price-flash'), 500);
                        }
                        cached.price = coin.price;
                        updatedCount++;
                    }
                    
                    // Atualizar change se mudou
                    if (cached.change_24h !== coin.change_24h) {
                        const changeEl = document.getElementById('change-' + symbolId);
                        if (changeEl) {
                            const changeClass = coin.change_24h >= 0 ? 'text-success' : 'text-danger';
                            const changeIcon = coin.change_24h >= 0 ? 'bi-caret-up-fill' : 'bi-caret-down-fill';
                            changeEl.className = changeClass;
                            changeEl.innerHTML = \`<i class="bi \${changeIcon}"></i> \${Math.abs(coin.change_24h).toFixed(2)}%\`;
                        }
                        cached.change_24h = coin.change_24h;
                        updatedCount++;
                    }
                    
                    // Atualizar RSI se mudou
                    if (cached.rsi !== coin.rsi) {
                        const rsiEl = document.getElementById('rsi-' + symbolId);
                        if (rsiEl) {
                            const rsiClass = coin.rsi < 30 ? 'text-success fw-bold' : (coin.rsi > 70 ? 'text-danger fw-bold' : 'text-muted');
                            rsiEl.className = rsiClass;
                            rsiEl.textContent = 'RSI: ' + coin.rsi.toFixed(1);
                        }
                        cached.rsi = coin.rsi;
                        updatedCount++;
                    }
                });
                
                if (updatedCount > 0) {
                    console.log('[Market] Incremental update -', updatedCount, 'changes');
                }
            }
            
            document.getElementById('marketUpdateTime').textContent = new Date().toLocaleTimeString();
            
        } catch (error) {
            console.error('Error fetching market data:', error);
        }
    }
    
