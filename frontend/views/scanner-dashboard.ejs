</style>

<script>
    // State
    let isContinuousRunning = false;
    let scanInterval = null;
    let signalHistory = [];
    let nearAlerts = {};
    
    const API_BASE = 'http://localhost:3008';
    const STORAGE_KEY = 'scannerConfig';
    
    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadSavedConfig();  // Load saved config first
        initializeScanner();
        fetchMarketData();
        updateNearAlerts();
        
        // Auto-refresh market data every 30 seconds
        setInterval(fetchMarketData, 30000);
        setInterval(updateNearAlerts, 15000);
        
        // Add auto-save event listeners to all config inputs
        setupAutoSave();
    });
    
    // Setup auto-save for all configuration inputs
    function setupAutoSave() {
        // Auto-save when symbols checkboxes change
        document.querySelectorAll('#scannerConfigForm input[type="checkbox"]').forEach(cb => {
            cb.addEventListener('change', function() {
                saveConfig();
                console.log('Config auto-saved after checkbox change');
            });
        });
        
        // Auto-save when range sliders change
        document.querySelectorAll('#scannerConfigForm input[type="range"]').forEach(range => {
            range.addEventListener('change', function() {
                saveConfig();
                console.log('Config auto-saved after range change');
            });
        });
    }
    
    // Save configuration to localStorage
    function saveConfig() {
        const config = {
            symbols: [],
            timeframes: [],
            minStrength: document.getElementById('minStrength').value,
            scanInterval: document.getElementById('scanInterval').value
        };
        
        // Get selected symbols
        document.querySelectorAll('#scannerConfigForm input[type="checkbox"][id^="chk"]').forEach(cb => {
            if (cb.value.includes('/')) {
                config.symbols.push({ id: cb.id, checked: cb.checked });
            } else {
                config.timeframes.push({ id: cb.id, value: cb.value, checked: cb.checked });
            }
        });
        
        localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
        console.log('Config saved:', config);
    }
    
    // Load configuration from localStorage
    function loadSavedConfig() {
        const savedConfig = localStorage.getItem(STORAGE_KEY);
        if (!savedConfig) {
            console.log('No saved config found, using defaults');
            return;
        }
        
        try {
            const config = JSON.parse(savedConfig);
            console.log('Loading saved config:', config);
            
            // Restore symbols checkboxes
            if (config.symbols && config.symbols.length > 0) {
                config.symbols.forEach(item => {
                    const cb = document.getElementById(item.id);
                    if (cb) cb.checked = item.checked;
                });
            }
            
            // Restore timeframes checkboxes
            if (config.timeframes && config.timeframes.length > 0) {
                config.timeframes.forEach(item => {
                    const cb = document.getElementById(item.id);
                    if (cb) cb.checked = item.checked;
                });
            }
            
            // Restore minStrength
            if (config.minStrength) {
                document.getElementById('minStrength').value = config.minStrength;
                document.getElementById('strengthValue').textContent = config.minStrength;
            }
            
            // Restore scanInterval
            if (config.scanInterval) {
                document.getElementById('scanInterval').value = config.scanInterval;
                document.getElementById('intervalValue').textContent = config.scanInterval;
            }
            
        } catch (e) {
            console.error('Error loading saved config:', e);
        }
    }
    
    async function initializeScanner() {
        try {
            const symbols = getSelectedSymbols();
            const timeframes = getSelectedTimeframes();
            
            const response = await fetch(API_BASE + '/api/scanner/init', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    symbols: symbols,
                    timeframes: timeframes,
                    min_signal_strength: parseFloat(document.getElementById('minStrength').value)
                })
            });
            
            const data = await response.json();
            if (data.success) {
                document.getElementById('symbolsMonitored').textContent = data.config.symbols.length + ' símbolos';
                showToast('Scanner Inicializado', 'Monitorando ' + data.config.symbols.length + ' símbolos', 'success');
            }
        } catch (error) {
            console.error('Error initializing scanner:', error);
            showToast('Erro', 'Falha ao inicializar scanner', 'danger');
        }
    }
    
    async function runScan() {
        const btn = document.getElementById('btnScan');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Escaneando...';
        
        try {
            const symbols = getSelectedSymbols();
            const timeframes = getSelectedTimeframes();
            
            const response = await fetch(API_BASE + '/api/scanner/scan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ symbols, timeframes })
            });
            
            const data = await response.json();
            
            if (data.success) {
                updateSignalsTable(data.signals);
                updateLastScan(data.last_scan_time);
                document.getElementById('signalCount').textContent = data.signals_found;
                
                // Add to history
                if (data.signals && data.signals.length > 0) {
                    addToHistory(data.signals);
                    playAlertSound();
                    showSignalAlerts(data.signals);
                }
                
                showToast('Scan Completo', 
                    'Encontrados ' + data.signals_found + ' sinais em ' + data.symbols_scanned + ' símbolos', 
                    data.signals_found > 0 ? 'warning' : 'info');
            }
        } catch (error) {
            console.error('Error running scan:', error);
            showToast('Erro', 'Falha ao executar scan', 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-search"></i> Scan Agora';
        }
    }
    
    function toggleContinuousScan() {
        const btn = document.getElementById('btnContinuous');
        const statusBadge = document.getElementById('scannerStatus');
        
        if (isContinuousRunning) {
            // Stop
            clearInterval(scanInterval);
            isContinuousRunning = false;
            btn.innerHTML = '<i class="bi bi-play-circle"></i> Iniciar Contínuo';
            btn.classList.remove('btn-danger');
            btn.classList.add('btn-outline-primary');
            statusBadge.textContent = 'Parado';
            statusBadge.classList.remove('bg-success');
            statusBadge.classList.add('bg-secondary');
            showToast('Scanner Parado', 'Monitoramento contínuo desativado', 'info');
        } else {
            // Start
            const interval = parseInt(document.getElementById('scanInterval').value) * 1000;
            runScan(); // Run immediately
            scanInterval = setInterval(runScan, interval);
            isContinuousRunning = true;
            btn.innerHTML = '<i class="bi bi-stop-circle"></i> Parar';
            btn.classList.remove('btn-outline-primary');
            btn.classList.add('btn-danger');
            statusBadge.textContent = 'Rodando';
            statusBadge.classList.remove('bg-secondary');
            statusBadge.classList.add('bg-success');
            showToast('Scanner Iniciado', 'Escaneando a cada ' + (interval/1000) + ' segundos', 'success');
        }
    }
    
    function updateSignalsTable(signals) {
        const tbody = document.getElementById('signalsTableBody');
        
        if (!signals || signals.length === 0) {
            tbody.innerHTML = \`
                <tr>
                    <td colspan="12" class="text-center text-muted py-5">
                        <i class="bi bi-check-circle display-4 d-block mb-3 text-success"></i>
                        <p>Nenhuma divergência RSI detectada no momento.</p>
                        <small>O scanner continua monitorando...</small>
                    </td>
                </tr>
            \`;
            return;
        }
        
        let html = '';
        signals.forEach(signal => {
            const rowClass = signal.direction === 'BUY' ? 'signal-bullish' : 'signal-bearish';
            const directionBadge = signal.direction === 'BUY' 
                ? '<span class="badge bg-success"><i class="bi bi-arrow-up"></i> COMPRA</span>'
                : '<span class="badge bg-danger"><i class="bi bi-arrow-down"></i> VENDA</span>';
            
            const strengthClass = signal.strength >= 0.7 ? 'text-success' : (signal.strength >= 0.5 ? 'text-warning' : 'text-danger');
            
            const confirmations = [];
            if (signal.confirmations.volume) confirmations.push('<span class="badge badge-confirmed confirmation-badge">Vol</span>');
            else confirmations.push('<span class="badge badge-unconfirmed confirmation-badge">Vol</span>');
            if (signal.confirmations.macd) confirmations.push('<span class="badge badge-confirmed confirmation-badge">MACD</span>');
            else confirmations.push('<span class="badge badge-unconfirmed confirmation-badge">MACD</span>');
            if (signal.confirmations.trend) confirmations.push('<span class="badge badge-confirmed confirmation-badge">Trend</span>');
            else confirmations.push('<span class="badge badge-unconfirmed confirmation-badge">Trend</span>');
            
            html += \`
                <tr class="\${rowClass}">
                    <td><strong>\${signal.symbol}</strong></td>
                    <td>
                        <span class="badge bg-info">\${formatSignalType(signal.type)}</span>
                        <br><small class="text-muted">\${signal.timeframe}</small>
                    </td>
                    <td>\${directionBadge}</td>
                    <td class="\${strengthClass}">
                        <strong>\${(signal.strength * 100).toFixed(0)}%</strong>
                        <br><small>\${signal.strength_level}</small>
                    </td>
                    <td>
                        <div class="rsi-gauge" style="width: 80px;">
                            <div class="rsi-marker" style="left: \${signal.rsi}%;"></div>
                        </div>
                        <small>\${signal.rsi.toFixed(1)}</small>
                    </td>
                    <td>\${formatPrice(signal.price)}</td>
                    <td class="text-primary fw-bold">\${formatPrice(signal.entry)}</td>
                    <td class="text-danger">\${formatPrice(signal.stop_loss)}</td>
                    <td class="text-success">\${formatPrice(signal.take_profit)}</td>
                    <td><span class="badge bg-secondary">\${signal.risk_reward.toFixed(1)}:1</span></td>
                    <td>\${confirmations.join(' ')}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-success" onclick="openPaperTrade('\${signal.symbol}', '\${signal.direction}', \${signal.entry})">
                            <i class="bi bi-play-circle"></i> Paper
                        </button>
                    </td>
                </tr>
            \`;
        });
        
        tbody.innerHTML = html;
    }
    
    function showSignalAlerts(signals) {
        const container = document.getElementById('alertsContainer');
        let html = '';
        
        signals.forEach(signal => {
            const alertClass = signal.direction === 'BUY' ? 'alert-success' : 'alert-danger';
            const icon = signal.direction === 'BUY' ? 'bi-arrow-up-circle-fill' : 'bi-arrow-down-circle-fill';
            
            html += \`
                <div class="alert \${alertClass} alert-dismissible fade show" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi \${icon} fs-3 me-3"></i>
                        <div class="flex-grow-1">
                            <h5 class="alert-heading mb-1">
                                \${signal.direction === 'BUY' ? '🟢 SINAL DE COMPRA' : '🔴 SINAL DE VENDA'} - \${signal.symbol}
                            </h5>
                            <p class="mb-0">
                                <strong>\${formatSignalType(signal.type)}</strong> detectada com 
                                <strong>\${(signal.strength * 100).toFixed(0)}%</strong> de força
                                (RSI: \${signal.rsi.toFixed(1)})
                            </p>
                            <small>
                                Entrada: \${formatPrice(signal.entry)} | 
                                SL: \${formatPrice(signal.stop_loss)} | 
                                TP: \${formatPrice(signal.take_profit)} | 
                                R/R: \${signal.risk_reward.toFixed(1)}:1
                            </small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-dark ms-3" onclick="openPaperTrade('\${signal.symbol}', '\${signal.direction}', \${signal.entry})">
                            <i class="bi bi-play-circle"></i> Operar
                        </button>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            \`;
        });
        
        container.innerHTML = html;
    }
    
    async function updateNearAlerts() {
        const container = document.getElementById('nearAlertsRow');
        
        try {
            // Fetch real market data from API
            const symbols = getSelectedSymbols().map(s => s.replace('/', '')).join(',');
            const response = await fetch(API_BASE + '/api/scanner/market-data?symbols=' + symbols);
            const result = await response.json();
            
            if (!result.success || !result.data || result.data.length === 0) {
                container.innerHTML = \`
                    <div class="col-12 text-center text-muted py-4">
                        <i class="bi bi-wifi-off display-4 d-block mb-2"></i>
                        <p>Aguardando dados do mercado...</p>
                    </div>
                \`;
                return;
            }
            
            let html = '';
            
            // Mostrar apenas os que têm proximidade > 0 ou RSI extremo
            const alertData = result.data.filter(item => 
                item.proximity > 0 || item.rsi <= 35 || item.rsi >= 65
            ).slice(0, 6);
            
            if (alertData.length === 0) {
                html = \`
                    <div class="col-12 text-center text-muted py-4">
                        <i class="bi bi-check-circle display-4 d-block mb-2 text-success"></i>
                        <p>Nenhuma divergência em formação no momento</p>
                        <small>RSI de todos os ativos está na faixa neutra (35-65)</small>
                    </div>
                \`;
            } else {
                alertData.forEach(item => {
                    const proximityColor = item.proximity >= 70 ? 'danger' : (item.proximity >= 40 ? 'warning' : 'secondary');
                    
                    // Definir status e descrição com base na proximidade e RSI
                    let statusText = '';
                    let statusIcon = '';
                    let statusDescription = '';
                    
                    if (item.trend === 'forming_bullish') {
                        statusText = '🟢 Possível Bullish Div.';
                        statusIcon = 'arrow-up-circle';
                        statusDescription = 'RSI subindo enquanto preço pode estar caindo';
                    } else if (item.trend === 'forming_bearish') {
                        statusText = '🔴 Possível Bearish Div.';
                        statusIcon = 'arrow-down-circle';
                        statusDescription = 'RSI caindo enquanto preço pode estar subindo';
                    } else if (item.trend === 'watching_bullish' || item.rsi <= 35) {
                        statusText = '👀 RSI Baixo - Atenção';
                        statusIcon = 'eye';
                        statusDescription = 'Zona de sobrevenda, potencial reversão de alta';
                    } else if (item.trend === 'watching_bearish' || item.rsi >= 65) {
                        statusText = '👀 RSI Alto - Atenção';
                        statusIcon = 'eye';
                        statusDescription = 'Zona de sobrecompra, potencial reversão de baixa';
                    } else {
                        statusText = '📊 Monitorando';
                        statusIcon = 'hourglass-split';
                        statusDescription = 'Avaliando condições de mercado';
                    }
                    
                    // Calcular nível de urgência
                    let urgencyBadge = '';
                    if (item.proximity >= 70) {
                        urgencyBadge = '<span class="badge bg-danger pulse-animation">IMINENTE</span>';
                    } else if (item.proximity >= 40) {
                        urgencyBadge = '<span class="badge bg-warning text-dark">FORMANDO</span>';
                    } else if (item.proximity > 0) {
                        urgencyBadge = '<span class="badge bg-secondary">OBSERVANDO</span>';
                    }
                    
                    const cardClass = item.proximity >= 70 ? 'near-alert-card forming' : 'near-alert-card';
                    const changeClass = item.change_24h >= 0 ? 'text-success' : 'text-danger';
                    const changeIcon = item.change_24h >= 0 ? 'caret-up-fill' : 'caret-down-fill';
                    
                    html += \`
                        <div class="col-md-4 mb-3">
                            <div class="card \${cardClass} h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="mb-0 fw-bold">\${item.symbol}</h6>
                                            <small class="text-muted">\${formatPrice(item.price)}</small>
                                        </div>
                                        <div class="text-end">
                                            \${urgencyBadge}
                                            \${item.proximity > 0 ? \`<div class="small text-\${proximityColor} fw-bold mt-1">\${item.proximity}% próximo</div>\` : ''}
                                        </div>
                                    </div>
                                    
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between align-items-center small mb-1">
                                            <span class="text-muted">RSI</span>
                                            <span class="\${item.rsi < 35 ? 'text-success fw-bold' : (item.rsi > 65 ? 'text-danger fw-bold' : 'text-muted')}">\${item.rsi.toFixed(1)}</span>
                                        </div>
                                        <div class="rsi-gauge">
                                            <div class="rsi-marker" style="left: \${item.rsi}%;"></div>
                                        </div>
                                        <div class="d-flex justify-content-between small text-muted mt-1">
                                            <span>30</span>
                                            <span>50</span>
                                            <span>70</span>
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex justify-content-between align-items-center small mb-2">
                                        <span>24h:</span>
                                        <span class="\${changeClass} fw-bold">
                                            <i class="bi bi-\${changeIcon}"></i> \${Math.abs(item.change_24h).toFixed(2)}%
                                        </span>
                                    </div>
                                    
                                    <div class="border-top pt-2 mt-2">
                                        <p class="mb-1 small fw-bold text-\${proximityColor === 'danger' ? 'danger' : (proximityColor === 'warning' ? 'warning' : 'secondary')}">
                                            <i class="bi bi-\${statusIcon}"></i> \${statusText}
                                        </p>
                                        <p class="mb-0 small text-muted">\${statusDescription}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    \`;
                });
            }
            
            container.innerHTML = html;
            
        } catch (error) {
            console.error('Error updating near alerts:', error);
            container.innerHTML = \`
                <div class="col-12 text-center text-danger py-4">
                    <i class="bi bi-exclamation-triangle display-4 d-block mb-2"></i>
                    <p>Erro ao carregar dados: \${error.message}</p>
                </div>
            \`;
        }
    }
    
    async function fetchMarketData() {
        const container = document.getElementById('marketOverview');
        
        try {
            const symbols = getSelectedSymbols().map(s => s.replace('/', '')).slice(0, 6).join(',');
            const response = await fetch(API_BASE + '/api/scanner/market-data?symbols=' + symbols);
            const result = await response.json();
            
            if (!result.success || !result.data) {
                throw new Error('Falha ao buscar dados');
            }
            
            let html = '';
            result.data.forEach(coin => {
                const changeClass = coin.change_24h >= 0 ? 'text-success' : 'text-danger';
                const changeIcon = coin.change_24h >= 0 ? 'bi-caret-up-fill' : 'bi-caret-down-fill';
                const rsiClass = coin.rsi < 30 ? 'text-success fw-bold' : (coin.rsi > 70 ? 'text-danger fw-bold' : 'text-muted');
                
                html += \`
                    <div class="col-md-2 col-6 mb-3">
                        <div class="card market-card h-100">
                            <div class="card-body text-center p-2">
                                <h6 class="mb-1">\${coin.symbol.replace('/USDT', '')}</h6>
                                <h5 class="mb-1">\${formatPrice(coin.price)}</h5>
                                <span class="\${changeClass}">
                                    <i class="bi \${changeIcon}"></i> \${Math.abs(coin.change_24h).toFixed(2)}%
                                </span>
                                <br>
                                <small class="\${rsiClass}">RSI: \${coin.rsi.toFixed(1)}</small>
                            </div>
                        </div>
                    </div>
                \`;
            });
            
            container.innerHTML = html;
            document.getElementById('marketUpdateTime').textContent = new Date().toLocaleTimeString();
            
        } catch (error) {
            console.error('Error fetching market data:', error);
        }
    }
    
    function addToHistory(signals) {
        signals.forEach(signal => {
            signalHistory.unshift({
                ...signal,
                time: new Date().toLocaleTimeString()
            });
        });
        
        // Keep only last 50
        signalHistory = signalHistory.slice(0, 50);
        updateHistoryTable();
    }
    
    function updateHistoryTable() {
        const tbody = document.getElementById('historyTableBody');
        
        if (signalHistory.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">Sem histórico ainda</td></tr>';
            return;
        }
        
        let html = '';
        signalHistory.forEach(signal => {
            const dirBadge = signal.direction === 'BUY' 
                ? '<span class="badge bg-success">COMPRA</span>' 
                : '<span class="badge bg-danger">VENDA</span>';
            
            html += \`
                <tr>
                    <td>\${signal.time}</td>
                    <td><strong>\${signal.symbol}</strong></td>
                    <td><span class="badge bg-info">\${formatSignalType(signal.type)}</span></td>
                    <td>\${dirBadge}</td>
                    <td>\${(signal.strength * 100).toFixed(0)}%</td>
                    <td>\${formatPrice(signal.price)}</td>
                    <td>\${signal.rsi.toFixed(1)}</td>
                </tr>
            \`;
        });
        
        tbody.innerHTML = html;
    }
    
    function clearHistory() {
        signalHistory = [];
        updateHistoryTable();
        document.getElementById('alertsContainer').innerHTML = '';
        showToast('Histórico Limpo', 'Histórico de sinais foi limpo', 'info');
    }
    
    function applyConfig() {
        // Save configuration to localStorage
        saveConfig();
        
        initializeScanner();
        
        // Update scan interval if continuous is running
        if (isContinuousRunning) {
            clearInterval(scanInterval);
            const interval = parseInt(document.getElementById('scanInterval').value) * 1000;
            scanInterval = setInterval(runScan, interval);
        }
        
        showToast('Configuração Salva', 'Suas preferências foram salvas e serão mantidas ao recarregar a página', 'success');
    }
    
    function getSelectedSymbols() {
        const symbols = [];
        document.querySelectorAll('#scannerConfigForm input[type="checkbox"][id^="chk"]:checked').forEach(cb => {
            if (cb.value.includes('/')) symbols.push(cb.value);
        });
        return symbols.length > 0 ? symbols : ['BTC/USDT', 'ETH/USDT', 'SOL/USDT'];
    }
    
    // Select all symbols
    function selectAllSymbols() {
        document.querySelectorAll('#scannerConfigForm input[type="checkbox"][id^="chk"]').forEach(cb => {
            if (cb.value.includes('/')) cb.checked = true;
        });
        saveConfig();
    }
    
    // Select top 5 symbols only
    function selectTopSymbols() {
        const topSymbols = ['BTC/USDT', 'ETH/USDT', 'SOL/USDT', 'BNB/USDT', 'XRP/USDT'];
        document.querySelectorAll('#scannerConfigForm input[type="checkbox"][id^="chk"]').forEach(cb => {
            if (cb.value.includes('/')) {
                cb.checked = topSymbols.includes(cb.value);
            }
        });
        saveConfig();
    }
    
    function getSelectedTimeframes() {
        const timeframes = [];
        ['1h', '4h', '1d'].forEach(tf => {
            const cb = document.getElementById('chk' + tf);
            if (cb && cb.checked) timeframes.push(tf);
        });
        return timeframes.length > 0 ? timeframes : ['1h'];
    }
    
    function formatSignalType(type) {
        const types = {
            'bullish_divergence': 'Bullish Div.',
            'bearish_divergence': 'Bearish Div.',
            'hidden_bullish': 'Hidden Bullish',
            'hidden_bearish': 'Hidden Bearish'
        };
        return types[type] || type;
    }
    
    function formatPrice(price) {
        if (price >= 1000) return '$' + price.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        if (price >= 1) return '$' + price.toFixed(2);
        return '$' + price.toFixed(4);
    }
    
    function updateLastScan(timestamp) {
        const date = new Date(timestamp);
        document.getElementById('lastScan').innerHTML = '<i class="bi bi-clock"></i> Último scan: ' + date.toLocaleTimeString();
    }
    
    function playAlertSound() {
        try {
            const audio = document.getElementById('alertSound');
            audio.volume = 0.3;
            audio.play().catch(e => console.log('Audio play failed:', e));
        } catch (e) {}
    }
    
    function showToast(title, message, type = 'info') {
        const container = document.getElementById('toastContainer');
        const id = 'toast-' + Date.now();
        
        const bgClass = {
            'success': 'bg-success',
            'danger': 'bg-danger',
            'warning': 'bg-warning text-dark',
            'info': 'bg-info text-dark'
        }[type] || 'bg-secondary';
        
        const html = \`
            <div id="\${id}" class="toast" role="alert">
                <div class="toast-header \${bgClass} text-white">
                    <strong class="me-auto">\${title}</strong>
                    <small>agora</small>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                </div>
                <div class="toast-body">\${message}</div>
            </div>
        \`;
        
        container.insertAdjacentHTML('beforeend', html);
        const toast = new bootstrap.Toast(document.getElementById(id));
        toast.show();
    }
    
    function openPaperTrade(symbol, direction, price) {
        // Redirect to paper trading with pre-filled data
        const url = '/paper-trading?symbol=' + encodeURIComponent(symbol.replace('/', '')) + 
                    '&direction=' + direction + 
                    '&price=' + price;
        window.open(url, '_blank');
    }
</script>
