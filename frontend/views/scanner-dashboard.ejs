    // ==========================================
    // AUTOTRADE FUNCTIONS - 100% LOCAL (SIMPLIFIED)
    // ==========================================
    
    let autotradeActive = false;
    let autotradeStatusInterval = null;
    let autotradeStats = { signals_processed: 0, trades_executed: 0, start_time: null };
    let autotradeSignalsLog = [];  // Log local de sinais
    let autotradeConfig = { dryRun: true, minStrength: 0.5, capital: 10000 };
    
    // Initialize AutoTrade on page load
    document.addEventListener('DOMContentLoaded', function() {
        // Restore AutoTrade state from localStorage
        restoreAutotradeState();
        
        // Setup dry run toggle
        document.getElementById('autotradeDryRun').addEventListener('change', function() {
            const label = document.getElementById('dryRunLabel');
            const modeLabel = document.querySelector('#autotradeModeLabel .badge');
            if (this.checked) {
                label.textContent = '🔴 DRY RUN (Simulação)';
                modeLabel.className = 'badge bg-warning text-dark';
                modeLabel.textContent = 'DRY RUN';
            } else {
                label.textContent = '🟢 LIVE (Execução Real)';
                modeLabel.className = 'badge bg-success';
                modeLabel.textContent = 'LIVE';
            }
            // Save config change
            saveAutotradeFullState();
        });
    });
    
    // Save FULL AutoTrade state (including stats and logs)
    function saveAutotradeFullState() {
        const symbols = getSelectedSymbols().map(s => s.replace('/', ''));
        const state = {
            active: autotradeActive,
            stats: autotradeStats,
            signals: autotradeSignalsLog.slice(-50),  // Keep last 50 signals
            config: {
                dryRun: document.getElementById('autotradeDryRun')?.checked ?? true,
                minStrength: parseFloat(document.getElementById('autotradeMinStrength')?.value || 0.5),
                capital: parseFloat(document.getElementById('autotradeCapital')?.value || 10000),
                symbols: symbols
            },
            timestamp: Date.now()
        };
        localStorage.setItem(AUTOTRADE_STATE_KEY, JSON.stringify(state));
        console.log('[AutoTrade] Full state saved');
    }
    
    // Restore AutoTrade state from localStorage
    function restoreAutotradeState() {
        const savedState = localStorage.getItem(AUTOTRADE_STATE_KEY);
        if (!savedState) {
            console.log('[AutoTrade] No saved state found');
            updateAutotradeUILocal();
            return;
        }
        
        try {
            const state = JSON.parse(savedState);
            
            // Check if state is not too old (24h max)
            if (state.timestamp && (Date.now() - state.timestamp) > 24 * 60 * 60 * 1000) {
                console.log('[AutoTrade] Saved state too old (>24h), ignoring');
                localStorage.removeItem(AUTOTRADE_STATE_KEY);
                updateAutotradeUILocal();
                return;
            }
            
            // Restore state
            autotradeActive = state.active || false;
            autotradeStats = state.stats || { signals_processed: 0, trades_executed: 0, start_time: null };
            autotradeSignalsLog = state.signals || [];
            autotradeConfig = state.config || { dryRun: true, minStrength: 0.5, capital: 10000 };
            
            // Restore UI config
            if (state.config) {
                const dryRunEl = document.getElementById('autotradeDryRun');
                const minStrengthEl = document.getElementById('autotradeMinStrength');
                const capitalEl = document.getElementById('autotradeCapital');
                
                if (dryRunEl) dryRunEl.checked = state.config.dryRun;
                if (minStrengthEl) minStrengthEl.value = state.config.minStrength;
                if (capitalEl) capitalEl.value = state.config.capital;
                
                // Trigger UI update for dry run label
                if (dryRunEl) {
                    const label = document.getElementById('dryRunLabel');
                    const modeLabel = document.querySelector('#autotradeModeLabel .badge');
                    if (state.config.dryRun) {
                        label.textContent = '🔴 DRY RUN (Simulação)';
                        modeLabel.className = 'badge bg-warning text-dark';
                        modeLabel.textContent = 'DRY RUN';
                    } else {
                        label.textContent = '🟢 LIVE (Execução Real)';
                        modeLabel.className = 'badge bg-success';
                        modeLabel.textContent = 'LIVE';
                    }
                }
            }
            
            console.log('[AutoTrade] State restored:', { active: autotradeActive, signals: autotradeSignalsLog.length });
            
            // Update UI
            updateAutotradeUILocal();
            
            // If was active, restart the polling
            if (autotradeActive) {
                console.log('[AutoTrade] Resuming active session...');
                autotradeStatusInterval = setInterval(() => updateAutotradeUILocal(), 5000);
                showToast('AutoTrade Restaurado', 'Sessão anterior restaurada com sucesso', 'info');
            }
            
        } catch (e) {
            console.error('[AutoTrade] Error restoring state:', e);
            localStorage.removeItem(AUTOTRADE_STATE_KEY);
            updateAutotradeUILocal();
        }
    }
    
    // UI Update function (100% local)
    function updateAutotradeUILocal() {
        const badge = document.getElementById('autotradeStatusBadge');
        const btn = document.getElementById('btnAutotrade');
        const header = document.getElementById('autotradeHeader');
        
        if (autotradeActive) {
            badge.className = 'badge bg-success ms-2';
            badge.textContent = 'Ativo';
            btn.className = 'btn btn-danger btn-sm me-2';
            btn.innerHTML = '<i class="bi bi-stop-fill"></i> Parar AutoTrade';
            header.style.background = 'linear-gradient(135deg, #0f5132 0%, #198754 100%)';
        } else {
            badge.className = 'badge bg-secondary ms-2';
            badge.textContent = 'Inativo';
            btn.className = 'btn btn-success btn-sm me-2';
            btn.innerHTML = '<i class="bi bi-play-fill"></i> Iniciar AutoTrade';
            header.style.background = 'linear-gradient(135deg, #1a1a2e 0%, #16213e 100%)';
        }
        
        // Update stats from local state
        document.getElementById('atSignalsProcessed').textContent = autotradeStats.signals_processed || 0;
        document.getElementById('atTradesExecuted').textContent = autotradeStats.trades_executed || 0;
        
        const symbols = getSelectedSymbols();
        document.getElementById('atSymbolsActive').textContent = autotradeActive ? symbols.length : '--';
        
        // Update last signal/trade from log
        if (autotradeSignalsLog.length > 0) {
            const lastSig = autotradeSignalsLog[autotradeSignalsLog.length - 1];
            document.getElementById('atLastSignal').textContent = \`\${lastSig.symbol} \${lastSig.direction}\`;
            
            const lastTrade = autotradeSignalsLog.filter(s => s.executed).pop();
            if (lastTrade) {
                document.getElementById('atLastTrade').textContent = \`\${lastTrade.symbol} @ \${new Date(lastTrade.timestamp).toLocaleTimeString()}\`;
            }
        } else {
            document.getElementById('atLastSignal').textContent = '--';
            document.getElementById('atLastTrade').textContent = '--';
        }
        
        // Update log table
        updateAutotradeLogLocal();
    }
    
    function updateAutotradeLogLocal() {
        const tbody = document.getElementById('autotradeLogBody');
        
        if (autotradeSignalsLog.length === 0) {
            tbody.innerHTML = \`
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">
                        <i class="bi bi-inbox"></i> Nenhum sinal processado ainda
                    </td>
                </tr>
            \`;
            return;
        }
        
        // Show most recent first
        const signals = [...autotradeSignalsLog].reverse();
        tbody.innerHTML = signals.map(sig => \`
            <tr>
                <td>\${new Date(sig.timestamp).toLocaleTimeString()}</td>
                <td><strong>\${sig.symbol}</strong></td>
                <td>
                    <span class="badge bg-\${sig.direction === 'BUY' ? 'success' : 'danger'}">
                        \${sig.direction}
                    </span>
                </td>
                <td>\${(sig.strength * 100).toFixed(0)}%</td>
                <td>
                    <span class="badge bg-\${sig.executed ? 'success' : (sig.processed ? 'warning' : 'secondary')}">
                        \${sig.executed ? 'Executado' : (sig.processed ? 'Ignorado' : 'Não processado')}
                    </span>
                </td>
                <td class="small">\${sig.reason || '--'}</td>
            </tr>
        \`).join('');
    }
    
    // Toggle AutoTrade (100% local - no backend dependency for state)
    function toggleAutotrade() {
        console.log('[AutoTrade] toggleAutotrade called, current state:', autotradeActive);
        
        if (autotradeActive) {
            stopAutotradeLocal();
        } else {
            startAutotradeLocal();
        }
    }
    
    // Start AutoTrade (100% local)
    function startAutotradeLocal() {
        const symbols = getSelectedSymbols();
        
        if (symbols.length === 0) {
            showToast('Erro', 'Nenhum símbolo selecionado', 'danger');
            return;
        }
        
        const dryRun = document.getElementById('autotradeDryRun').checked;
        const minStrength = parseFloat(document.getElementById('autotradeMinStrength').value);
        const capital = parseFloat(document.getElementById('autotradeCapital').value);
        
        // Set state
        autotradeActive = true;
        autotradeStats = { 
            signals_processed: 0, 
            trades_executed: 0, 
            start_time: Date.now() 
        };
        autotradeConfig = { dryRun, minStrength, capital, symbols: symbols.map(s => s.replace('/', '')) };
        
        // Save to localStorage immediately
        saveAutotradeFullState();
        
        // Start polling
        if (autotradeStatusInterval) clearInterval(autotradeStatusInterval);
        autotradeStatusInterval = setInterval(() => {
            saveAutotradeFullState();  // Persist state periodically
            updateAutotradeUILocal();
        }, 5000);
        
        // Update UI
        updateAutotradeUILocal();
        
        // Show notification
        showToast('AutoTrade Iniciado', 
            \`Modo: \${dryRun ? '🔴 DRY RUN (simulação)' : '🟢 LIVE (execução real)'} | \${symbols.length} pares | Min. Força: \${(minStrength * 100).toFixed(0)}%\`, 
            dryRun ? 'warning' : 'success');
        
        console.log('[AutoTrade] Started:', { dryRun, minStrength, capital, symbols: symbols.length });
    }
    
    // Stop AutoTrade (100% local)
    function stopAutotradeLocal() {
        // Stop polling
        if (autotradeStatusInterval) {
            clearInterval(autotradeStatusInterval);
            autotradeStatusInterval = null;
        }
        
        // Calculate session summary
        const duration = autotradeStats.start_time ? 
            Math.round((Date.now() - autotradeStats.start_time) / 1000 / 60) : 0;
        
        // Set state
        autotradeActive = false;
        
        // Save to localStorage
        saveAutotradeFullState();
        
        // Update UI
        updateAutotradeUILocal();
        
        // Show notification
        showToast('AutoTrade Parado', 
            \`Duração: \${duration} min | Sinais: \${autotradeStats.signals_processed} | Trades: \${autotradeStats.trades_executed}\`, 
            'info');
        
        console.log('[AutoTrade] Stopped:', autotradeStats);
    }
    
    // Process signal locally (called by scanner when it detects a signal)
    function processSignalLocally(signal) {
        if (!autotradeActive) return;
        
        const minStrength = autotradeConfig.minStrength || 0.5;
        const signalStrength = signal.strength || 0;
        
        // Create log entry
        const logEntry = {
            timestamp: Date.now(),
            symbol: signal.symbol?.replace('/', '') || 'UNKNOWN',
            direction: signal.direction === 1 ? 'BUY' : 'SELL',
            strength: signalStrength,
            processed: true,
            executed: false,
            reason: ''
        };
        
        autotradeStats.signals_processed++;
        
        // Check if signal meets criteria
        if (signalStrength < minStrength) {
            logEntry.reason = \`Força \${(signalStrength * 100).toFixed(0)}% < mínimo \${(minStrength * 100).toFixed(0)}%\`;
        } else {
            // Signal meets criteria - would execute
            if (autotradeConfig.dryRun) {
                logEntry.executed = true;
                logEntry.reason = '✅ DRY RUN - Simulado';
                autotradeStats.trades_executed++;
                
                showToast('AutoTrade (DRY RUN)', 
                    \`🔵 \${logEntry.symbol} \${logEntry.direction} simulado | Força: \${(signalStrength * 100).toFixed(0)}%\`, 
                    'info');
            } else {
                // LIVE mode - call backend to execute
                executeTradeOnBackend(signal).then(result => {
                    if (result.success) {
                        logEntry.executed = true;
                        logEntry.reason = '✅ Executado';
                        autotradeStats.trades_executed++;
                    } else {
                        logEntry.reason = \`❌ Falha: \${result.error}\`;
                    }
                    saveAutotradeFullState();
                    updateAutotradeUILocal();
                });
                logEntry.reason = '⏳ Executando...';
            }
        }
        
        // Add to log (keep last 50)
        autotradeSignalsLog.push(logEntry);
        if (autotradeSignalsLog.length > 50) {
            autotradeSignalsLog = autotradeSignalsLog.slice(-50);
        }
        
        // Save and update UI
        saveAutotradeFullState();
        updateAutotradeUILocal();
        
        console.log('[AutoTrade] Signal processed:', logEntry);
    }
    
    // Execute trade on backend (for LIVE mode only)
    async function executeTradeOnBackend(signal) {
        try {
            const response = await fetch(API_BASE + '/api/autotrade/process-signal', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    symbol: signal.symbol?.replace('/', ''),
                    direction: signal.direction,
                    signal_type: signal.signal_type,
                    strength: signal.strength,
                    entry_price: signal.entry_price,
                    stop_loss: signal.stop_loss,
                    take_profit: signal.take_profit,
                    timeframe: signal.timeframe || '1h'
                })
            });
            
            const data = await response.json();
            return { success: data.success && data.action === 'executed', error: data.message };
        } catch (e) {
            console.error('[AutoTrade] Backend execution error:', e);
            return { success: false, error: e.message };
        }
    }
</script>
