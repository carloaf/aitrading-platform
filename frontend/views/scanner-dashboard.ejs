    .toast-header.bg-success { background-color: #198754 !important; }
    .toast-header.bg-danger { background-color: #dc3545 !important; }
    .toast-header.bg-warning { background-color: #ffc107 !important; color: #212529 !important; }
    .toast-header.bg-info { background-color: #0dcaf0 !important; color: #212529 !important; }
    
