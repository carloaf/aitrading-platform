<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estratégias de Trading - AI Trading Platform</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --primary-color: #6366f1;
            --success-color: #10b981;
            --danger-color: #ef4444;
            --dark-bg: #1f2937;
            --card-bg: #374151;
        }
        
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .navbar {
            background: rgba(31, 41, 55, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .main-container {
            padding: 2rem 0;
        }
        
        .strategy-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        
        .strategy-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
        }
        
        .strategy-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #e5e7eb;
        }
        
        .strategy-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1f2937;
        }
        
        .metric-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-bottom: 1rem;
        }
        
        .metric-box {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1rem;
            border-radius: 10px;
            text-align: center;
        }
        
        .metric-box.positive {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }
        
        .metric-box.negative {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        }
        
        .metric-label {
            font-size: 0.75rem;
            opacity: 0.9;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .metric-value {
            font-size: 1.5rem;
            font-weight: 700;
            margin-top: 0.25rem;
        }
        
        .controls-section {
            background: white;
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }
        
        .btn-run-backtest {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            border: none;
            padding: 0.75rem 2rem;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-run-backtest:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(99, 102, 241, 0.4);
        }
        
        .loading-spinner {
            display: none;
            text-align: center;
            padding: 2rem;
        }
        
        .chart-container {
            position: relative;
            height: 300px;
            margin-top: 1rem;
        }
        
        .trades-table {
            max-height: 300px;
            overflow-y: auto;
        }
        
        .trade-row {
            font-size: 0.875rem;
        }
        
        .trade-profit {
            color: #10b981;
            font-weight: 600;
        }
        
        .trade-loss {
            color: #ef4444;
            font-weight: 600;
        }
        
        .comparison-chart {
            background: white;
            border-radius: 15px;
            padding: 2rem;
            margin-top: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }
        
        .badge-rank {
            font-size: 1rem;
            padding: 0.5rem 1rem;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-dark navbar-expand-lg sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="fas fa-chart-line me-2"></i>AI Trading Platform
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="fas fa-home me-1"></i>Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/strategies"><i class="fas fa-brain me-1"></i>Estratégias</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/backtesting"><i class="fas fa-chart-bar me-1"></i>Backtesting</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="container main-container">
        <!-- Controls Section -->
        <div class="controls-section">
            <h2 class="mb-4"><i class="fas fa-cog me-2"></i>Configurações do Backtest</h2>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Símbolo</label>
                    <select class="form-select" id="symbolSelect">
                        <option value="BTCUSDT" selected>Bitcoin (BTCUSDT)</option>
                        <option value="ETHUSDT">Ethereum (ETHUSDT)</option>
                        <option value="BNBUSDT">Binance Coin (BNBUSDT)</option>
                        <option value="ADAUSDT">Cardano (ADAUSDT)</option>
                        <option value="SOLUSDT">Solana (SOLUSDT)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Data Inicial</label>
                    <input type="date" class="form-control" id="startDate" value="2023-01-01">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Data Final</label>
                    <input type="date" class="form-control" id="endDate" value="2024-12-01">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Capital Inicial</label>
                    <input type="number" class="form-control" id="initialCapital" value="10000" step="1000">
                </div>
            </div>
            <div class="mt-4">
                <button class="btn btn-primary btn-run-backtest" onclick="runAllStrategies()">
                    <i class="fas fa-play me-2"></i>Executar Todas as Estratégias
                </button>
                <button class="btn btn-outline-primary ms-2" onclick="clearResults()">
                    <i class="fas fa-trash me-2"></i>Limpar Resultados
                </button>
            </div>
        </div>

        <!-- Loading Spinner -->
        <div class="loading-spinner" id="loadingSpinner">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="mt-3">Executando backtests...</p>
        </div>

        <!-- Results Container -->
        <div id="resultsContainer"></div>

        <!-- Comparison Chart -->
        <div class="comparison-chart" id="comparisonChart" style="display: none;">
            <h3 class="mb-4"><i class="fas fa-chart-bar me-2"></i>Comparação de Retornos</h3>
            <div class="chart-container" style="height: 400px;">
                <canvas id="comparisonCanvas"></canvas>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const BACKTEST_API = 'http://localhost:3007';
        const STRATEGIES = [
            'trend_following',
            'mean_reversion',
            'volatility_breakout',
            'macd_rsi_combo',
            'bollinger_bands',
            'momentum',
            'volume_profile',
            'multi_timeframe',
            'dynamic_position_sizing'
        ];

        const STRATEGY_NAMES = {
            'trend_following': 'Trend Following',
            'mean_reversion': 'Mean Reversion',
            'volatility_breakout': 'Volatility Breakout',
            'macd_rsi_combo': 'MACD + RSI Combo',
            'bollinger_bands': 'Bollinger Bands',
            'momentum': 'Momentum',
            'volume_profile': 'Volume Profile',
            'multi_timeframe': 'Multi-Timeframe',
            'dynamic_position_sizing': 'Dynamic Position Sizing'
        };

        let allResults = [];
        let comparisonChart = null;

        async function runAllStrategies() {
            const symbol = document.getElementById('symbolSelect').value;
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            const initialCapital = document.getElementById('initialCapital').value;

            document.getElementById('loadingSpinner').style.display = 'block';
            document.getElementById('resultsContainer').innerHTML = '';
            allResults = [];

            for (const strategy of STRATEGIES) {
                try {
                    const url = `${BACKTEST_API}/strategies/${strategy}/backtest?symbol=${symbol}&start_date=${startDate}&end_date=${endDate}&initial_capital=${initialCapital}`;
                    const response = await fetch(url, { method: 'POST' });
                    const data = await response.json();
                    
                    if (response.ok) {
                        allResults.push({ strategy, data });
                        renderStrategyCard(strategy, data);
                    } else {
                        console.error(`Erro em ${strategy}:`, data.detail);
                    }
                } catch (error) {
                    console.error(`Erro ao executar ${strategy}:`, error);
                }
            }

            document.getElementById('loadingSpinner').style.display = 'none';
            
            // Ordenar por retorno
            allResults.sort((a, b) => b.data.total_return - a.data.total_return);
            
            // Renderizar gráfico de comparação
            renderComparisonChart();
        }

        function renderStrategyCard(strategy, data) {
            const container = document.getElementById('resultsContainer');
            const isProfit = data.total_return > 0;
            const rank = allResults.length;
            
            const card = document.createElement('div');
            card.className = 'strategy-card';
            card.innerHTML = `
                <div class="strategy-header">
                    <div>
                        <span class="badge badge-rank bg-primary">#${rank}</span>
                        <span class="strategy-name ms-2">${STRATEGY_NAMES[strategy]}</span>
                    </div>
                    <div>
                        <span class="badge ${isProfit ? 'bg-success' : 'bg-danger'} fs-5">
                            ${isProfit ? '↑' : '↓'} ${data.total_return.toFixed(2)}%
                        </span>
                    </div>
                </div>
                
                <div class="metric-row">
                    <div class="metric-box ${isProfit ? 'positive' : 'negative'}">
                        <div class="metric-label">Capital Final</div>
                        <div class="metric-value">$${data.final_capital.toFixed(2)}</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Total de Trades</div>
                        <div class="metric-value">${data.total_trades}</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Win Rate</div>
                        <div class="metric-value">${data.win_rate.toFixed(1)}%</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Vencedores</div>
                        <div class="metric-value">${data.winning_trades}</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Perdedores</div>
                        <div class="metric-value">${data.losing_trades}</div>
                    </div>
                </div>
                
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Equity Curve</h5>
                        <div class="chart-container">
                            <canvas id="chart-${strategy}"></canvas>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h5>Últimos Trades</h5>
                        <div class="trades-table">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Entrada</th>
                                        <th>Saída</th>
                                        <th>PnL</th>
                                        <th>%</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${data.trades.map(trade => `
                                        <tr class="trade-row">
                                            <td>${trade.entry_date}</td>
                                            <td>${trade.exit_date}</td>
                                            <td class="${trade.pnl > 0 ? 'trade-profit' : 'trade-loss'}">
                                                $${trade.pnl.toFixed(2)}
                                            </td>
                                            <td class="${trade.pnl_pct > 0 ? 'trade-profit' : 'trade-loss'}">
                                                ${trade.pnl_pct.toFixed(2)}%
                                            </td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
            
            container.appendChild(card);
            
            // Renderizar gráfico da equity curve
            setTimeout(() => renderEquityCurve(strategy, data.equity_curve), 100);
        }

        function renderEquityCurve(strategy, equityCurve) {
            const ctx = document.getElementById(`chart-${strategy}`);
            if (!ctx) return;
            
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: equityCurve.map(point => point.date),
                    datasets: [{
                        label: 'Equity',
                        data: equityCurve.map(point => point.equity),
                        borderColor: '#6366f1',
                        backgroundColor: 'rgba(99, 102, 241, 0.1)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: { display: false },
                        y: {
                            ticks: {
                                callback: value => '$' + value.toFixed(0)
                            }
                        }
                    }
                }
            });
        }

        function renderComparisonChart() {
            if (allResults.length === 0) return;
            
            document.getElementById('comparisonChart').style.display = 'block';
            
            const ctx = document.getElementById('comparisonCanvas');
            
            if (comparisonChart) {
                comparisonChart.destroy();
            }
            
            comparisonChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: allResults.map(r => STRATEGY_NAMES[r.strategy]),
                    datasets: [{
                        label: 'Retorno (%)',
                        data: allResults.map(r => r.data.total_return),
                        backgroundColor: allResults.map(r => 
                            r.data.total_return > 0 ? 'rgba(16, 185, 129, 0.8)' : 'rgba(239, 68, 68, 0.8)'
                        ),
                        borderColor: allResults.map(r => 
                            r.data.total_return > 0 ? 'rgb(16, 185, 129)' : 'rgb(239, 68, 68)'
                        ),
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: context => `Retorno: ${context.parsed.y.toFixed(2)}%`
                            }
                        }
                    },
                    scales: {
                        y: {
                            ticks: {
                                callback: value => value + '%'
                            }
                        }
                    }
                }
            });
        }

        function clearResults() {
            document.getElementById('resultsContainer').innerHTML = '';
            document.getElementById('comparisonChart').style.display = 'none';
            allResults = [];
        }

        // Definir data padrão como hoje
        document.getElementById('endDate').valueAsDate = new Date();
    </script>
</body>
</html>
