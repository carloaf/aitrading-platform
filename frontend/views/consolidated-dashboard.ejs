    async function detectRegime() {
        try {
            const response = await fetch(API_BASE + '/api/market-regime/detect', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ symbol: 'BTCUSDT', interval: '1h', lookback_days: 30 })
            });
            
            const data = await response.json();
            
            if (data.regime) {
                const regimeColors = {
                    'bull': 'success',
                    'bear': 'danger',
                    'sideways': 'warning',
                    'volatile_crisis': 'dark'
                };
                
                const regimeIcons = {
                    'bull': 'bi-graph-up-arrow',
                    'bear': 'bi-graph-down-arrow',
                    'sideways': 'bi-arrows-expand',
                    'volatile_crisis': 'bi-exclamation-triangle'
                };
                
                const regime = data.regime.toLowerCase();
                const color = regimeColors[regime] || 'secondary';
                const icon = regimeIcons[regime] || 'bi-question-circle';
                
                document.getElementById('currentRegime').innerHTML = \`
                    <span class="text-\${color}">
                        <i class="bi \${icon}"></i> \${data.regime.toUpperCase()}
                    </span>
                \`;
                
                document.getElementById('regimeConfidence').textContent = (data.confidence * 100).toFixed(1) + '%';
                
                // Update recommended strategies
                if (data.recommended_strategies && data.recommended_strategies.length > 0) {
                    document.getElementById('recommendedStrategies').innerHTML = 
                        data.recommended_strategies.map(s => 
                            \`<span class="badge bg-primary me-1">\${s}</span>\`
                        ).join('');
                }
            }
        } catch (e) {
            document.getElementById('currentRegime').innerHTML = '<span class="text-muted"><i class="bi bi-exclamation-circle"></i> Erro</span>';
            console.error('Erro ao detectar regime:', e);
        }
    }
</script>
