                    <div class="metric-label">Sinais de Compra</div>
                    <div class="metric-value text-success"><%= stats.buy_signals %></div>
                </div>
                <div class="text-success" style="font-size: 2.5rem;">
                    <i class="bi bi-arrow-up-circle"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="metric-card">
