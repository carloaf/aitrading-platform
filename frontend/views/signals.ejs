                            <h6 class="text-muted">Gerado em:</h6>
                            <p class="mb-0"><%= formatDate(latestSignal.created_at) %></p>
                        </div>
                    </div>
                </div>
                
                <hr>
                
                <div class="row">
                    <div class="col-md-12">
                        <h6 class="text-muted">Análise:</h6>
                        <p class="mb-0"><%= latestSignal.description %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<% } %>

<!-- Statistics -->
<% if (stats) { %>
<div class="row mb-4">
    <div class="col-md-3">
