# ==========================================
# CONFIGURAÇÕES MARKET DATA COLLECTOR
# ==========================================

# Porta do serviço
PORT=3001

# Símbolos para monitorar (separados por vírgula)
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,ADAUSDT,BNBUSDT,SOLUSDT

# Intervalos de dados (separados por vírgula)
MARKET_DATA_INTERVALS=1m,5m,15m,1h,4h

# Configurações de log
LOG_LEVEL=info

# URLs de conexão (serão sobrescritas pelo Docker)
REDIS_URL=redis://redis:6379
TIMESCALE_URL=postgresql://crypto_user:crypto_pass@timescaledb:5432/crypto_market

# APIs Binance (configurar no .env principal)
# BINANCE_API_KEY=your_key_here
# BINANCE_SECRET_KEY=your_secret_here
