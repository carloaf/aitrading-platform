# ════════════════════════════════════════════════════════════════
# CONFIGURAÇÃO DE INICIALIZAÇÃO AUTOMÁTICA
# ════════════════════════════════════════════════════════════════

# Habilita health check na inicialização do container
ENABLE_STARTUP_HEALTH_CHECK=true

# Baixa automaticamente dados faltantes do Binance
AUTO_DOWNLOAD_MISSING_DATA=true

# Popula banco com trades históricos para ML training
AUTO_POPULATE_HISTORICAL_TRADES=true

# ════════════════════════════════════════════════════════════════
# COMO FUNCIONA:
# ════════════════════════════════════════════════════════════════
#
# 1. STARTUP HEALTH CHECK (ENABLE_STARTUP_HEALTH_CHECK=true):
#    - Verifica integridade dos dados no banco
#    - Identifica candles faltantes
#    - Valida se há trades suficientes para ML training
#
# 2. AUTO DOWNLOAD (AUTO_DOWNLOAD_MISSING_DATA=true):
#    - Baixa automaticamente candles faltantes do Binance
#    - Preenche gaps temporais
#    - Garante 90% de completude mínima
#
# 3. AUTO POPULATE (AUTO_POPULATE_HISTORICAL_TRADES=true):
#    - Gera trades históricos simulados (backtest results)
#    - Popula banco com 500+ trades realistas
#    - Permite treinar ML Filter imediatamente
#
# ════════════════════════════════════════════════════════════════
# CENÁRIOS DE USO:
# ════════════════════════════════════════════════════════════════
#
# DESENVOLVIMENTO (rápido, dados sintéticos):
#   ENABLE_STARTUP_HEALTH_CHECK=true
#   AUTO_DOWNLOAD_MISSING_DATA=false      # Pula download (lento)
#   AUTO_POPULATE_HISTORICAL_TRADES=true  # Usa dados sintéticos
#
# PRODUÇÃO (completo, dados reais):
#   ENABLE_STARTUP_HEALTH_CHECK=true
#   AUTO_DOWNLOAD_MISSING_DATA=true       # Baixa dados reais
#   AUTO_POPULATE_HISTORICAL_TRADES=true  # Treina ML com histórico
#
# MANUAL (sem automação):
#   ENABLE_STARTUP_HEALTH_CHECK=false
#   AUTO_DOWNLOAD_MISSING_DATA=false
#   AUTO_POPULATE_HISTORICAL_TRADES=false
#   # Use: ./scripts/setup_ml_data.sh full
#
# ════════════════════════════════════════════════════════════════

# Nota: O health check adiciona ~30-60s no startup, mas garante
# que o sistema sempre tenha dados necessários para operar.
